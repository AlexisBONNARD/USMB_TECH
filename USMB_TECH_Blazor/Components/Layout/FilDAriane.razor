@inject NavigationManager NavManager

<link href="css/FilDAriane.css" rel="stylesheet" />

@code {
    private List<BreadcrumbItem> Items = new();

    protected override void OnInitialized()
    {
        BuildBreadcrumb();
    }

    private void BuildBreadcrumb()
    {
        var uri = NavManager.ToBaseRelativePath(NavManager.Uri);
        var segments = uri.Split('/', StringSplitOptions.RemoveEmptyEntries);

        string cumulative = "";

        foreach (var segment in segments)
        {
            cumulative += "/" + segment;
            Items.Add(new BreadcrumbItem
            {
                Text = Capitalize(segment),
                Url = cumulative
            });
        }
    }

    private string Capitalize(string text)
        => char.ToUpper(text[0]) + text.Substring(1);
}

@* <ul class="breadcrumb">
    <li><a href="/">Accueil</a></li>
    @foreach (var item in Items)
    {
        <li>
            <a href="@item.Url">@item.Text</a>
        </li>
    }
</ul> *@

@if (Items.Count > 0)
{
    <div class="breadcrumb-container">
        <ul class="breadcrumb">
            <li><a href="/">USMB Tech</a></li>
            @foreach (var item in Items)
            {
                <li>
                    <a href="@item.Url">@item.Text</a>
                </li>
            }
        </ul>
    </div>
}

@code {
    public class BreadcrumbItem
    {
        public string Text { get; set; }
        public string Url { get; set; }
    }
}