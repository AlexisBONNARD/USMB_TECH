@using USMB_TECH_Blazor.Models
@using USMB_TECH_Blazor.Service
@inject IMainService<Plateforme,int> PlateformeService
@inject NavigationManager Nav

<div class="usmb-nav-container">
    <div class="usmb-nav">
        <NavLink class="" href="" Match="NavLinkMatch.All">
            <span class=""></span> USMB TECH
        </NavLink>

        <!-- Dropdown NOS PLATEFORMES -->
        <div class="nav-link dropdown" @onclick="ToggleDropdown" style="cursor:pointer;">
            <span class="dropdown-toggle">NOS PLATEFORMES</span>
            @if (showDropdown && plateformes != null)
            {
                <ul class="dropdown-menu">
                    @foreach (var p in plateformes)
                    {
                        <li @onclick="() => GoToPlateforme(p.Id_Plateforme)">
                            @p.Nom_Plateforme
                        </li>
                    }
                </ul>
            }
        </div>

        <NavLink class="" href="Equipement">
            <span class=""></span> NOS ÉQUIPEMENTS
        </NavLink>

    </div>
</div>

@code {
    private bool showDropdown = false;
    private IEnumerable<Plateforme>? plateformes;

    protected override async Task OnInitializedAsync()
    {
        plateformes = await PlateformeService.GetAllAsync();
    }

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
    }

    private void GoToPlateforme(int id)
    {
        Nav.NavigateTo($"/plateforme/{id}");
        showDropdown = false;
    }
}
