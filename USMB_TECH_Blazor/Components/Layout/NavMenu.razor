@using USMB_TECH_Blazor.Models;
@using USMB_TECH_Blazor.Service;
@inject IMainService<Pole_Expertise,int> Pole_ExpertiseService
@inject IMainService<Equipement,int> EquipementService
@inject IMainService<Prestation,int> PrestationService
@inject IMainService<Laboratoire,string> LaboratoireService
@inject IMainService<Prise_Contact, int> Prise_ContactService
@inject IMainService<Contact_USMB, int> ContactService
@inject AdminState AdminState
@inject NavigationManager Nav
@inject IJSRuntime JS


<div class="usmb-nav-container">
    <div class="usmb-nav">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <span class="" >USMB TECH</span>
        </NavLink>

        <!-- Dropdown NOS POLES D'EXPERTISE -->
        <div class="nav-link dropdown"
             data-testid="nav-pole-menu"
             @onmouseenter="@(() => OpenDropdown("Pole_Expertise"))"
             @onmouseleave="@CloseDropdown"
             style="cursor:pointer;">

            <span class="dropdown-toggle">POLES D'EXPERTISE</span>

            <ul class="dropdown-menu @(showDropdown == "Pole_Expertise" ? "show" : "")">
                @if (pole_expertises != null)
                {
                    @foreach (var pl in pole_expertises)
                    {
                        if (pl.Actif)
                        {
                            <li data-testid="nav-pole-item" 
                                @onclick="() => GoToPole_Expertise(pl.Id_Pole_Expertise)">
                                @pl.Nom_Pole_Expertise
                            </li>
                        }
                        @if (AdminState.IsAdmin && !pl.Actif)
                        {
                            <li data-testid="nav-pole-item"
                                @onclick="() => GoToPole_Expertise(pl.Id_Pole_Expertise)" style="background-color: lightgray">
                                @pl.Nom_Pole_Expertise
                            </li>
                        }
                    }
                }
            </ul>
        </div>

        <!-- Dropdown NOS EQUIPEMENTS -->
        <div class="nav-link dropdown"
             data-testid="nav-equipement-menu"
             @onmouseenter="@(() => OpenDropdown("Equipement"))"
             @onmouseleave="@CloseDropdown"
             style="cursor:pointer;">

            <span class="dropdown-toggle">EQUIPEMENTS</span>

            <ul class="dropdown-menu @(showDropdown == "Equipement" ? "show" : "")">
                @if (equipements != null)
                {
                    @foreach (var eq in equipements)
                    {
                        <li data-testid="nav-equipement-item"
                            @onclick="() => GoToEquipement(eq.Id_Equipement)">
                            @eq.Nom_Equipement
                        </li>
                    }
                }
            </ul>
        </div>

        <!-- Dropdown NOS PRESTATIONS -->
        <div class="nav-link dropdown"
             data-testid="nav-prestation-menu"
             @onmouseenter="@(() => OpenDropdown("Prestation"))"
             @onmouseleave="@CloseDropdown"
             style="cursor:pointer;">

            <span class="dropdown-toggle">PRESTATIONS</span>

            <ul class="dropdown-menu @(showDropdown == "Prestation" ? "show" : "")">
                @if (prestations != null)
                {
                    @foreach (var pr in prestations)
                    {
                        <li data-testid="nav-prestation-item"
                            @onclick="() => GoToPrestation(pr.Id_Prestation)">
                            @pr.Intitule_Prestation
                        </li>
                    }
                }
            </ul>
        </div>

        <!-- Dropdown NOS LABORATOIRES -->
        <div class="nav-link dropdown"
             data-testid="nav-laboratoire-menu"
             @onmouseenter="@(() => OpenDropdown("Laboratoire"))"
             @onmouseleave="@CloseDropdown"
             style="cursor:pointer;">

            <span class="dropdown-toggle">LABORATOIRE</span>

            <ul class="dropdown-menu @(showDropdown == "Laboratoire" ? "show" : "")">
                @if (laboratoires != null)
                {
                    @foreach (var lab in laboratoires)
                    {
                        <li data-testid="nav-laboratoire-item"
                            @onclick="() => GoToLaboratoire(lab.Nom_Court)">
                            @lab.Nom_Court
                        </li>
                    }
                }
            </ul>
        </div>
        
        @if (AdminState.IsAdmin)
        {
            <!-- Dropdown NOS PRISE_CONTACTS -->
            <span class="nav-link dropdown"
                 @onclick="@(() => RetourListe("prise_contact"))"
                 style="cursor:pointer;">
                <span class="">PRISE_CONTACT</span>
            </span>
        }

        <!-- Dropdown NOS CONTACTS -->
        <span class="nav-link"
             @onclick="@(() => RetourListe("contact"))">
            <span class="">CONTACT</span>
        </span>
    </div>

</div>


@code {
    private string showDropdown = null;
    private IEnumerable<Pole_Expertise>? pole_expertises;
    private IEnumerable<Equipement>? equipements;
    private IEnumerable<Prestation>? prestations;
    private IEnumerable<Laboratoire>? laboratoires;
    protected override async Task OnInitializedAsync()
    {
        pole_expertises = await Pole_ExpertiseService.GetAllAsync();
        equipements = await EquipementService.GetAllAsync();
        prestations = await PrestationService.GetAllAsync();
        laboratoires = await LaboratoireService.GetAllAsync();

        // Affichage dans la console
        if (pole_expertises != null)
        {
            foreach (var p in pole_expertises)
            {
                await JS.InvokeVoidAsync("console.log", $"Pole_Expertise: {p.Nom_Pole_Expertise}, Id: {p.Id_Pole_Expertise}");
            }
        }

        if (equipements != null)
        {
            foreach (var e in equipements)
            {
                await JS.InvokeVoidAsync("console.log", $"Equipement: {e.Nom_Equipement}, Id: {e.Id_Equipement}");
            }
        }

        if (prestations != null)
        {
            foreach (var e in prestations)
            {
                await JS.InvokeVoidAsync("console.log", $"Prestation: {e.Nom_Court}, Id: {e.Id_Prestation}");
            }
        }

        if (laboratoires != null)
        {
            foreach (var e in laboratoires)
            {
                await JS.InvokeVoidAsync("console.log", $"Laboratoire: {e.Nom_Long}, Id: {e.Nom_Court}");
            }
        }
    }
    private void ToggleDropdownPole_Expertise()
    {
        showDropdown = showDropdown == "Pole_Expertise" ? null : "Pole_Expertise";
    }

    private void ToggleDropdownEquipement()
    {
        showDropdown = showDropdown == "Equipement" ? null : "Equipement";
    }

    private void ToggleDropdownPrestation()
    {
        showDropdown = showDropdown == "Prestation" ? null : "Prestation";
    }

    private void ToggleDropdownLaboratoire()
    {
        showDropdown = showDropdown == "Laboratoire" ? null : "Laboratoire";
    }

    private void GoToPole_Expertise(int id)
    {
        Nav.NavigateTo($"/pole_expertise/{id}", true);
        showDropdown = null;
    }

    private void GoToEquipement(int id)
    {
        Nav.NavigateTo($"/equipement/{id}", true);
        showDropdown = null;
    }

    private void GoToPrestation(int id)
    {
        Nav.NavigateTo($"/prestation/{id}", true);
        showDropdown = null;
    }

    private void GoToLaboratoire(string id)
    {
        Nav.NavigateTo($"/laboratoire/{id}", true);
        showDropdown = null;
    }

    private void OpenDropdown(string name)
    {
        showDropdown = name;
    }

    private void CloseDropdown()
    {
        showDropdown = null;
    }

    private void RetourListe(string nomChemin)
    {
        Nav.NavigateTo($"/{nomChemin}");
    }
}
