@using USMB_TECH_Blazor.Models;
@using USMB_TECH_Blazor.Service;
@inject IMainService<Plateforme,int> PlateformeService
@inject IMainService<Equipement,int> EquipementService
@inject NavigationManager Nav
@inject IJSRuntime JS


<div class="usmb-nav-container">
    <div class="usmb-nav">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <span class=""></span> USMB TECH
        </NavLink>

        <!-- Dropdown NOS PLATEFORMES -->
        <div class="nav-link dropdown " style="cursor:pointer;" @onclick="ToggleDropdownPlateforme">
            <span class="dropdown-toggle">NOS PLATEFORMES</span>
            <ul class="dropdown-menu @(showDropdown == "Plateforme" ? "show" : "")">
                @if (plateformes != null)
                {
                    @foreach (var p in plateformes)
                    {
                        <li @onclick="() => GoToPlateforme(p.Id_Plateforme)">
                            @p.Nom_Plateforme
                        </li>
                    }
                }
            </ul>
        </div>

        <!-- Dropdown NOS EQUIPEMENTS -->
        <div class="nav-link dropdown " style="cursor:pointer;" @onclick="ToggleDropdownEquipement">
            <span class="dropdown-toggle">NOS EQUIPEMENTS</span>
            <ul class="dropdown-menu @(showDropdown == "Equipement" ? "show" : "")">
                @if (equipements != null)
                {
                    @foreach (var eq in equipements)
                    {
                        <li @onclick="() => GoToEquipement(eq.Id_Equipement)">
                            @eq.Nom_Equipement
                        </li>
                    }
                }
            </ul>
        </div>

    </div>

</div>


@code {
    private string showDropdown = null;
    private IEnumerable<Plateforme>? plateformes;
    private IEnumerable<Equipement>? equipements;
    protected override async Task OnInitializedAsync()
    {
        plateformes = await PlateformeService.GetAllAsync();
        equipements = await EquipementService.GetAllAsync();

        // Affichage dans la console
        if (plateformes != null)
        {
            foreach (var p in plateformes)
            {
                await JS.InvokeVoidAsync("console.log", $"Plateforme: {p.Nom_Plateforme}, Id: {p.Id_Plateforme}");
            }
        }

        if (equipements != null)
        {
            foreach (var e in equipements)
            {
                await JS.InvokeVoidAsync("console.log", $"Equipement: {e.Nom_Equipement}, Id: {e.Id_Equipement}");
            }
        }

    }

    private void ToggleDropdownPlateforme()
    {
        showDropdown = showDropdown == "Plateforme" ? null : "Plateforme";
    }

    private void ToggleDropdownEquipement()
    {
        showDropdown = showDropdown == "Equipement" ? null : "Equipement";
    }

    private void GoToPlateforme(int id)
    {
        Nav.NavigateTo($"/plateforme/{id}", true);
        showDropdown = null;
    }

    private void GoToEquipement(int id)
    {
        Nav.NavigateTo($"/equipement/{id}", true);
        showDropdown = null;
    }
}
