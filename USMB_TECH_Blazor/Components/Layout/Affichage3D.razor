@page "/3d-viewer"
<link href="css/Affichage3D.css" rel="stylesheet" />

<div style="height:300px;width:100%;">
    <Viewer @ref="viewer"
            ViewerSettings="settings"
            Scene="scene" />
</div>

@code {

    private Viewer viewer = null!;
    private Scene scene = new();
    private Guid loadedGuid;
    private string msg = string.Empty;
    [Parameter]public string urlModel { get; set; } = string.Empty;

    private readonly ViewerSettings settings = new ViewerSettings
    {
        // options si besoin
    };

    protected override void OnInitialized()
    {
        // Lumières uniquement
        scene.Add(new AmbientLight());

        scene.Add(new PointLight
        {
            Intensity = 0.5f,
            Position = new Vector3(-80, 80, 80)
        });
        scene.Add(new PointLight
        {
            Intensity = 0.5f,
            Position = new Vector3(80, -80, -80)
        });
        scene.Add(new PointLight
        {
            Intensity = 0.5f,
            Position = new Vector3(-80, 0, -80)
        });
        scene.Add(new PointLight
        {
            Intensity = 0.5f,
            Position = new Vector3(80, 0, 80)
        });
        scene.Add(new PointLight
        {
            Intensity = 0.5f,
            Position = new Vector3(0, 80, 0)
        });
        scene.Add(new PointLight
        {
            Intensity = 0.5f,
            Position = new Vector3(0, -80, 0)
        });
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return Task.CompletedTask;

        viewer.JsModuleLoaded += LoadModelAsync;
        viewer.ObjectLoaded += OnObjectLoaded;

        return Task.CompletedTask;
    }

    private async Task LoadModelAsync()
    {
        // Modèle stocké dans wwwroot/uploads/
        var modelUrl = $"uploads/{urlModel}"; // ou .glb

        loadedGuid = await viewer.Import3DModelAsync(new ImportSettings
        {
            Format = Import3DFormats.Gltf, // ou .Glb
            FileURL = modelUrl
        });

        // Position caméra (caméra JS par défaut)
        await viewer.SetCameraPositionAsync(
            new Vector3(45, 45, 45)
        );
    }

    private Task OnObjectLoaded(Object3DArgs e)
    {
        msg = $"Objet chargé : {e.UUID}";
        StateHasChanged();
        return Task.CompletedTask;
    }
}
