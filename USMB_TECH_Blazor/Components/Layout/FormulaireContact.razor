@inject IMainService<Pole_Expertise ,int> Pole_ExpertiseService
@inject IMainService<Equipement,int> EquipementService
@inject IMainService<Laboratoire, string> LaboratoireService
@inject IMainService<Prise_Contact,int> Prise_ContactService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<link href="css/FormulaireContact.css" rel="stylesheet" />

<div class="contact-section">
    <h3>FORMULAIRE DE CONTACT</h3>

    <EditForm Model="@prise_contact" OnValidSubmit="HandleSubmit" key="@prise_contact">
        <DataAnnotationsValidator />
        <div class="form-container">

            <div class="row">
                <InputText class="input half" @bind-Value="prise_contact.Nom_Contact" placeholder="Nom *" />
                <InputText class="input half" @bind-Value="prise_contact.Prenom_Contact" placeholder="Prénom *" />
                <ValidationMessage For="@(() => prise_contact.Nom_Contact)" />
                <ValidationMessage For="@(() => prise_contact.Prenom_Contact)" />
            </div>

            <InputText class="input" @bind-Value="prise_contact.Email_Contact" placeholder="Email *" />
            <ValidationMessage For="@(() => prise_contact.Email_Contact)" />

            <InputText class="input" @bind-Value="prise_contact.Entreprise_Contact"
                       placeholder="Type d’entité (entreprise, collectivité, association…) *" />
            <ValidationMessage For="@(() => prise_contact.Entreprise_Contact)" />

            <InputTextArea class="input textarea" @bind-Value="prise_contact.Description_besoins"
                           placeholder="Votre besoin *" />
            <ValidationMessage For="@(() => prise_contact.Description_besoins)" />
            <div class="row">
                <label>Vous souhaitez contacter :</label>
                <InputSelect class="input" @bind-Value="typeSelectionne">
                    <option value="Aucun">Je ne sais pas</option>
                    <option value="Equipement">Un équipement</option>
                    <option value="Pole">Un pôle d'expertise</option>
                    <option value="Laboratoire">Un laboratoire</option>
                </InputSelect>
            </div>

            @if (typeSelectionne == TypeCible.Equipement)
            {
                <div class="row">
                    <label>Équipement</label>
                    <InputSelect class="input" @bind-Value="prise_contact.Id_Equipement">
                        <option value="">Sélectionnez un équipement</option>
                        @foreach (var eq in equipements)
                        {
                            <option value="@eq.Id_Equipement">@eq.Nom_Equipement</option>
                        }
                    </InputSelect>
                </div>
            }

            @if (typeSelectionne == TypeCible.Pole)
            {
                <div class="row">
                    <label>Pôle d'expertise</label>
                    <InputSelect class="input" @bind-Value="prise_contact.Id_Pole_Expertise">
                        <option value="">Sélectionnez un pôle</option>
                        @foreach (var p in pole_expertises)
                        {
                            <option value="@p.Id_Pole_Expertise">@p.Nom_Pole_Expertise</option>
                        }
                    </InputSelect>
                </div>
            }

            @if (typeSelectionne == TypeCible.Laboratoire)
            {
                <div class="row">
                    <label>Laboratoire</label>
                    <InputSelect class="input" @bind-Value="prise_contact.Nom_Court">
                        <option value="">Sélectionnez un laboratoire</option>
                        @foreach (var l in laboratoires)
                        {
                            <option value="@l.Nom_Court">@l.Nom_Court</option>
                        }
                    </InputSelect>
                </div>
            }


            <button type="submit" class="submit-btn">ENVOYER</button>
        </div>
    </EditForm>

    @if (!string.IsNullOrEmpty(message))
    {
        <div id="alertMessage"
             class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-fixed"
             style="font-size:@(isMultipleErrors ? "18px" : "14px")"
             @onclick="() => message = null">
            @((MarkupString)message)
        </div>
    }
</div>

@code {
    private string? message;
    private bool isSuccess = false;
    private bool isMultipleErrors = false;
    private TypeCible typeSelectionne = TypeCible.Aucun;

    private Prise_Contact prise_contact = new()
    {
        Id_Type_Client = 1
    };

    private List<Pole_Expertise> pole_expertises = new();
    private List<Equipement> equipements = new();
    private List<Laboratoire> laboratoires = new();

    protected override async Task OnInitializedAsync()
    {
        pole_expertises = (await Pole_ExpertiseService.GetAllAsync())
            .Where(x => x != null).ToList()!;

        equipements = (await EquipementService.GetAllAsync())
            .Where(x => x != null).ToList()!;

        laboratoires = (await LaboratoireService.GetAllAsync())
            .Where(x => x != null).ToList()!;

        AutoFillFromUrl();
    }

    private void AutoFillFromUrl()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var segments = relative.Split('/', StringSplitOptions.RemoveEmptyEntries);

        for (int i = 0; i < segments.Length; i++)
        {
            if (segments[i].Equals("equipement", StringComparison.OrdinalIgnoreCase)
                && i + 1 < segments.Length
                && int.TryParse(segments[i + 1], out int idEquip))
            {
                typeSelectionne = TypeCible.Equipement;
                prise_contact.Id_Equipement = idEquip;
            }

            if (segments[i].Equals("pole_expertise", StringComparison.OrdinalIgnoreCase)
                && i + 1 < segments.Length
                && int.TryParse(segments[i + 1], out int idPole))
            {
                typeSelectionne = TypeCible.Pole;
                prise_contact.Id_Pole_Expertise = idPole;
            }

            if (segments[i].Equals("laboratoire", StringComparison.OrdinalIgnoreCase)
                && i + 1 < segments.Length)
            {
                typeSelectionne = TypeCible.Laboratoire;
                prise_contact.Nom_Court = segments[i + 1];
            }
        }
    }
    private void NormaliserAvantEnvoi()
    {
        if (typeSelectionne != TypeCible.Equipement)
            prise_contact.Id_Equipement = null;

        if (typeSelectionne != TypeCible.Pole)
            prise_contact.Id_Pole_Expertise = null;

        if (typeSelectionne != TypeCible.Laboratoire)
            prise_contact.Nom_Court = null;
    }

    private async Task HandleSubmit()
    {
        NormaliserAvantEnvoi();
        try
        {
            await Prise_ContactService.AddAsync(prise_contact);
            await ShowAlert("Votre demande a bien été envoyée !", true);

            prise_contact = new() { Id_Type_Client = 1 };
        }
        catch (Exception ex)
        {
            await ShowAlert("Erreur serveur.", false);
            await JS.InvokeVoidAsync("console.error", ex.ToString());
        }
    }

    private async Task ShowAlert(string msg, bool success)
    {
        message = msg;
        isSuccess = success;

        StateHasChanged();

        await Task.Delay(5000);

        message = null;
        isMultipleErrors = false;
        StateHasChanged();
    }
}
