@page "/domaine_excellence/edit/{Id:int}"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@using USMB_TECH.Models
@inject IJSRuntime JS
@using System.Text.Json;

<h2 class="add_style">Modifier le domaine d'excellence</h2>

@if (domaineExcellence == null)
{
    <p>Chargement...</p>
}
else
{
    <div class="page-container">
        <EditForm Model="@domaineExcellence" OnValidSubmit="SubmitDomaine">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <h4 class="add_style">Infos générales</h4>
            <label>Intitulé *</label>
            <InputText class="form-control mb-2" @bind-Value="domaineExcellence.Intitule_Domaine_Excellence" placeholder="Service et industrie du futur" />
            <ValidationMessage For="@(() => domaineExcellence.Intitule_Domaine_Excellence)" />

            <label>Description *</label>
            <InputText class="form-control mb-2" @bind-Value="domaineExcellence.Description_Domaine_Excellence" placeholder="Ce domaine d'excellence est focalisé sur l'industrie et les services du futur" />
            <ValidationMessage For="@(() => domaineExcellence.Description_Domaine_Excellence)" />

            <hr />
            <h4 class="add_style">Photos</h4>
            <InputFile OnChange="HandleFileUpload" multiple />
            @if (domaineExcellence.Photos != null && domaineExcellence.Photos.Any())
            {
                <div class="uploaded-photos">
                    <h5>Photos sélectionnées :</h5>
                    <ul>
                        @foreach (var photo in domaineExcellence.Photos)
                        {
                            <li>
                                <img src="@photo.Url_Photo" alt="@photo.Nom_Photo" style="max-width: 200px; max-height: 200px;" />
                                <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemovePhoto(photo)">Supprimer</button>
                            </li>
                        }
                    </ul>
                </div>
            }

            <hr />
            <button class="btn btn-primary mt-3" type="submit">Mettre à jour</button>
        </EditForm>
    </div>
}

@if (!string.IsNullOrEmpty(message))
{
    <div id="alertMessage" class="alert @(isSubmitted ? "alert-success" : "alert-danger") alert-fixed">
        @message
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    Domaine_Excellence? domaineExcellence;

    bool isSubmitted = false;
    string message = "";

    protected override async Task OnInitializedAsync()
    {
        domaineExcellence = await Http.GetFromJsonAsync<Domaine_Excellence>($"https://blazor-usmbtech-ekf6gkgretedd7bc.francecentral-01.azurewebsites.net/api/Domaine_Excellences/{Id}");

        var json = JsonSerializer.Serialize(domaineExcellence);
        await JS.InvokeVoidAsync("console.log", json);
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(); // Prendre en charge plusieurs fichiers

        // Réinitialiser les photos existantes avant d'ajouter les nouvelles
        domaineExcellence.Photos.Clear();  // Supprimer les anciennes photos de l'objet

        foreach (var file in files)
        {
            using var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10_000_000));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync("https://blazor-usmbtech-ekf6gkgretedd7bc.francecentral-01.azurewebsites.net/api/Domaine_Excellences/upload", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResponse>();
                domaineExcellence.Photos.Add(new Photo
                {
                    Nom_Photo = file.Name,
                    Url_Photo = result.url
                });
            }
        }
    }


    private void RemovePhoto(Photo photo)
    {
        domaineExcellence.Photos.Remove(photo);
    }

    public class UploadResponse
    {
        public string url { get; set; }
    }

    async Task SubmitDomaine()
    {
        try
        {
            // Si aucune photo uploadée → photo par défaut
            if (domaineExcellence.Photos == null || !domaineExcellence.Photos.Any())
            {
                domaineExcellence.Photos = new List<Photo>
                {
                    new Photo
                    {
                        Nom_Photo = "default-image.png",
                        Url_Photo = "/images/No_image_available.png"
                    }
                };
            }

            var response = await Http.PutAsJsonAsync($"https://blazor-usmbtech-ekf6gkgretedd7bc.francecentral-01.azurewebsites.net/api/Domaine_Excellences/{Id}", domaineExcellence);

            if (response.IsSuccessStatusCode)
            {
                isSubmitted = true;
                await ShowAlert("Domaine d'excellence mis à jour avec succès ✅");
            }
            else
            {
                isSubmitted = false;
                await ShowAlert("Erreur lors de la mise à jour ❌");
            }
        }
        catch (Exception ex)
        {
            isSubmitted = false;
            await ShowAlert($"Erreur: {ex.Message}");
        }
    }

    private async Task ShowAlert(string msg)
    {
        message = msg;
        StateHasChanged();

        await Task.Delay(3000); // Attend 3 secondes

        message = null;         // Efface le message
        StateHasChanged();      // Met à jour
        if (isSubmitted)
        {
            // Recharger les informations du domaine d'excellence mis à jour, y compris les photos.
            domaineExcellence = await Http.GetFromJsonAsync<Domaine_Excellence>($"https://blazor-usmbtech-ekf6gkgretedd7bc.francecentral-01.azurewebsites.net/api/Domaine_Excellences/{Id}");
            StateHasChanged();
            NavigationManager.NavigateTo($"/DomaineExcellence/{Id}");
        }
    }
}
