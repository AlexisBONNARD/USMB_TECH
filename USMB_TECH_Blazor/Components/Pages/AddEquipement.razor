@page "/ajouterEquipement"
@inject Service.IMainService<Pole_Expertise,int> pole_expertiseDatas
@inject Service.IMainService<Type_Equipement,int> typeEquipementDatas
@inject Service.IMainService<Equipement,int> equipementDatas
@inject Service.IMainService<Marque,int> marqueService
@inject Service.IMainService<Mot_Clef,int> motService
@inject Service.IMainService<Fonctionnalite,int> fonctionnaliteService
@inject Service.IMainService<Type_Client,int> typeClientService
@inject Service.IMainService<Type_Utilisation,int> typeUtilisationService
@inject NavigationManager Navigation
@inject AdminState AdminState
@inject HttpClient Http
@inject IJSRuntime JS

<HeadContent>
    <li class="add_style" nk href="css/addEquipement.css" rel="stylesheet" />
</HeadContent>
@if (isLoading)
{
    <div class="loading-overlay">
        <div class="spinner"></div>
    </div>
}
<h2 class="add_style">Ajouter un équipement</h2>

<div class="page-container">
    <EditForm Model="addEquipement" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <h4 class="add_style">Infos générales</h4>
        <label>Nom de l'équipement *</label>
        <InputText class="form-control mb-2" @bind-Value="addEquipement.Nom_Equipement" placeholder="Serveur" />
        <ValidationMessage For="@(() => addEquipement.Nom_Equipement)" />

        <label>Numéro d'immobilisation *</label>
        <InputText class="form-control mb-2" @bind-Value="addEquipement.Num_Immobilisation" placeholder="IT-2024-00157" />
        <ValidationMessage For="@(() => addEquipement.Num_Immobilisation)" />

        <label>Description Technique *</label>
        <InputText class="form-control mb-2" @bind-Value="addEquipement.Description_Technique" placeholder="Serveur permettant de stocker les données" />
        <ValidationMessage For="@(() => addEquipement.Description_Technique)" />

        <label>Prix Achat *</label>
        <InputNumber class="form-control mb-2" @bind-Value="addEquipement.Prix_Achat" />
        <ValidationMessage For="@(() => addEquipement.Prix_Achat)" />

        <label>Prix Revient *</label>
        <InputNumber class="form-control mb-2" @bind-Value="addEquipement.Prix_Revient" />
        <ValidationMessage For="@(() => addEquipement.Prix_Revient)" />
        <div class="checkbox-group">
            <InputCheckbox @bind-Value="addEquipement.Autonomie" />
            <label>Autonomie</label>
        </div>

        <div class="checkbox-group">
            <InputCheckbox @bind-Value="addEquipement.Utilisable_Chez_Le_Client" />
            <label>Utilisable chez le client</label>
        </div>

        <hr />
        <h4 class="add_style">Infos techniques</h4>
        <InputSelect class="form-control mb-2"
                     @bind-Value="fonctionnaliteId">
            <option value="0">----- Sélectionner une caractéristique -----</option>

            @foreach (var fonc in existingFonctionnalite)
            {
                <option value="@fonc.Id_Fonctionnalite">
                    @fonc.Nom_Fonctionnalite : @fonc.Description
                </option>
            }

            <option value="-1">----- Créer une caractéristique -----</option>
        </InputSelect>

        @if (fonctionnaliteId == -1)
        {
            <form onsubmit="return false;" class="mb-2">
                <div>
                    <label>Nom de la caractéristique : </label>
                    <InputText class="form-control mb-1"
                               @bind-Value="newCaracteristiqueNom"
                               placeholder="Nom de la caractéristique"
                               @onkeydown="@(e => { if (e.Key == "Enter") { AddCaracteristique(); } })" />
                </div>
                <div>
                    <label>
                        Description :
                    </label>
                    <input class="form-control mb-1"
                           @bind="newCaracteristiqueDesc"
                           @bind:event="oninput"
                           placeholder="Description / precision / unité ..."
                           @onkeydown="@(e => { if (e.Key == "Enter") { AddCaracteristique(); } })" />
                </div>
                @if (!string.IsNullOrWhiteSpace(newCaracteristiqueNom) && !string.IsNullOrWhiteSpace(newCaracteristiqueDesc))
                {
                    <button type="button" class="btn btn-secondary btn-sm mt-1" @onclick="AddCaracteristique">Ajouter</button>
                }

            </form>
        }
        else if (fonctionnaliteId > 0)
        {
            <button type="button" class="btn btn-secondary btn-sm mt-1" @onclick="AddCaracteristique">Ajouter cette caractéristique</button>
        }


        <ul class="add_style">
            @foreach (var fonc in addEquipement.Fonctionnalites)
            {
                <li class="add_style">
                    @fonc.Nom_Fonctionnalite : @fonc.Description
                    <button type="button" class="btn btn-sm btn-danger ms-2" @onclick="() => RemoveCaracteristique(fonc)">Supprimer</button>
                </li>
            }
        </ul>

        <hr />
        <h4 class="add_style">Photos</h4>
        <InputFile OnChange="HandleFileUpload" multiple />
        @if (!string.IsNullOrEmpty(fileErrorMessage))
        {
            <div class="alert alert-warning mt-2">
                @fileErrorMessage
            </div>
        }
        @if (addEquipement.Photos != null && addEquipement.Photos.Any())
        {
            <div class="uploaded-photos">
                <h5>Photos sélectionnées :</h5>
                <ul>
                    @foreach (var photo in addEquipement.Photos)
                    {
                        <li>
                            <img src="@photo.Url_Photo" alt="@photo.Nom_Photo" style="max-width: 200px; max-height: 200px;" />
                            <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemovePhoto(photo)">Supprimer</button>
                        </li>
                    }
                </ul>
            </div>
        }

        <hr />
        <h4 class="add_style">Modèle *</h4>
        <InputText class="form-control mb-2" @bind-Value="addEquipement.Nom_Modele" placeholder="LDLC PC SERVPRO 2U PRO Ultra 5" />
        <ValidationMessage For="@(() => addEquipement.Nom_Modele)" />

        <hr />
        <div class="form-group">
            <h4 class="add_style">Marque *</h4>
            <InputSelect class="form-select mb-2" @bind-Value="LastMarque" placeholder="LDLC">
                <option value="">----- Sélectionner une marque -----</option>
                @foreach (var marque in marques)
                {
                    <option value="@marque.Nom_Marque">@marque.Nom_Marque</option>
                }
                <option value="ajouter" class="alert-info">----- Créer une marque -----</option>
            </InputSelect>
            <ValidationMessage For="@(() => addEquipement.Nom_Marque)" />
        </div>
        @if (LastMarque == "ajouter")
        {
            <form onsubmit="return false;" class="mb-2">
                <input class="form-control mb-1"
                       @bind="newMarque"
                       @bind:event="oninput"
                       placeholder="Nom de la marque"
                       @onkeydown="@(e => { if (e.Key == "Enter") { AddMarque(); } })" />
                <button type="button" class="btn btn-secondary btn-sm mt-1" @onclick="AddMarque">Ajouter</button>
            </form>

            @if (derniereMarqueAjoutee != null)
            {
                <ul class="add_style">
                    <li class="add_style">
                        @derniereMarqueAjoutee.Nom_Marque
                        <button type="button" class="btn btn-sm btn-danger ms-2" @onclick="() => RemoveMarque(derniereMarqueAjoutee)">Supprimer</button>
                    </li>
                </ul>
            }
        }

        <hr />
        <h4 class="add_style">Pôle d'expertise *</h4>
        <InputSelect class="form-select mb-2" @bind-Value="LastPole_Expertise">
            <option value="">----- Sélectionner un pôle d'expertise -----</option>
            @foreach (var pole_expertise in pole_expertises)
            {
                <option value="@pole_expertise.Nom_Pole_Expertise">@pole_expertise.Nom_Pole_Expertise</option>
            }
            <option value="ajouter" class="alert-info">----- Créer un pôle d'expertise -----</option>
        </InputSelect>
        <ValidationMessage For="@(() => addEquipement.Nom_Pole_Expertise)" />

        <!-- Modal -->
        <div id="modalPole_Expertise" class="modal" style="display: none;">
            <div class="modal-content">
                <span class="close" @onclick="CloseModal">&times;</span>
                <AddPole_Expertise OnPole_ExpertiseAdded="OnPole_ExpertiseAdded" EnableRedirect="false" />
            </div>
        </div>

        <hr />
        <h4 class="add_style">Type d'équipement *</h4>
        <InputSelect class="form-select mb-2" @bind-Value="LastTypeEquipement">
            <option value="">----- Sélectionner un type d'équipement -----</option>
            @foreach (var type in type_Equipements)
            {
                <option value="@type.Nom_Type">@type.Nom_Type</option>
            }
            <option value="ajouter" class="alert-info">----- Créer un type -----</option>
        </InputSelect>
        <ValidationMessage For="@(() => addEquipement.Type_Equipement)" />
        @if (LastTypeEquipement == "ajouter")
        {
            <form onsubmit="return false;" class="mb-2">
                <input class="form-control mb-1"
                       @bind="newTypeEquipement"
                       @bind:event="oninput"
                       placeholder="Nom du type"
                       @onkeydown="@(e => { if (e.Key == "Enter") { AddTypeEquipement(); } })" />
                <button type="button" class="btn btn-secondary btn-sm mt-1" @onclick="AddTypeEquipement">Ajouter</button>
            </form>

            @if (dernierTypeAjoute != null)
            {
                <ul class="add_style">
                    <li class="add_style">
                        @dernierTypeAjoute.Nom_Type
                        <button type="button" class="btn btn-sm btn-danger ms-2" @onclick="() => RemoveTypeEquipement(dernierTypeAjoute)">Supprimer</button>
                    </li>
                </ul>
            }
        }
        <hr />
        <h4 class="add_style">Mots-clés</h4>
        <InputSelect class="form-control mb-2" @bind-Value="motCle">
            <option value="">----- Sélectionner un mot clé -----</option>
            @if (existingMot is not null)
            {
                @foreach (var mot in existingMot)
                {
                    <option value="@mot.Nom_Mot_Clef">@mot.Nom_Mot_Clef</option>
                }
            }
            <option value="ajouter" class="alert-info">----- Créer un mot clé -----</option>
        </InputSelect>
        @if (motCle == "ajouter")
        {
            <h4>Ajouter un mot-clé</h4>
            <form @onsubmit="AddMot_Clef" class="mb-2">
                <input class="form-control mb-2"
                       @bind="newMot_Clef"
                       @bind:event="oninput"
                       placeholder="Nouveau Mot-clé" />
                <button type="button" class="btn btn-secondary btn-sm mt-1" @onclick="AddMot_Clef">Ajouter</button>
            </form>
        }
        else if (!string.IsNullOrWhiteSpace(motCle))
        {
            <button type="button" class="btn btn-secondary btn-sm mt-1" @onclick="AddMot_Clef">Ajouter ce mot-clé</button>
        }

        <ul class="add_style">
            @foreach (var mc in addEquipement.MotsCles)
            {
                <li class="add_style">
                    @mc
                    <button type="button" class="btn btn-sm btn-danger ms-2" @onclick="() => RemoveMotCle(mc)">Supprimer</button>
                </li>
            }
        </ul>


        <hr />
        <h4 class="add_style">Exemple d'utilisation *</h4>
        <div>
            <label>Nom de l'exemple : </label>
            <InputText class="form-control mb-2" @bind-Value="addEquipement.Nom_Exemple" placeholder="Stockage" />
            <ValidationMessage For="@(() => addEquipement.Nom_Exemple)" />
        </div>
        <div>
            <label>
                Description :
                <span class="info-tooltip">
                    ⓘ
                    <span class="tooltip-text">
                        Dans cette section, vous pouvez décrire votre exemple afin d'aider
                        l'utilisateur à avoir une idée de l'utilisation de l'équipement.
                    </span>
                </span>
            </label>

            <InputText class="form-control mb-2"
                       @bind-Value="addEquipement.Description_Exemple"
                       placeholder="La base de données est stockée sur ce serveur" />

            <ValidationMessage For="@(() => addEquipement.Description_Exemple)" />
        </div>

        @* Type Client *@
        <hr />
        <h4 class="add_style">Types de clients autorisés</h4>

        @foreach (var tc in typeClients)
        {
            <div class="form-check">
                <input type="checkbox"
                       class="form-check-input"
                       checked="@selectedTypeClients.Contains(tc.Id_Type_Client)"
                       @onchange="e => ToggleTypeClient(tc.Id_Type_Client, (bool)e.Value)" />

                <label class="form-check-label">
                    @tc.Nom_Type_Client
                </label>
            </div>
        }
        
        @* Type Utilisateur *@
        <hr />
        <h4 class="add_style">Types d’utilisation proposés</h4>

        @foreach (var tu in typeUtilisations)
        {
            <div class="form-check">
                <input type="checkbox"
                       class="form-check-input"
                       checked="@selectedTypeUtilisations.Contains(tu.Id_Type_Utilisation)"
                       @onchange="e => ToggleTypeUtilisation(tu.Id_Type_Utilisation, (bool)e.Value)" />

                <label class="form-check-label">
                    @tu.Nom_Type_Utilisation
                </label>
            </div>
        }

        <hr />
        <button type="submit" class="btn btn-success mt-3">Ajouter</button>

        @if (!string.IsNullOrEmpty(message))
        {
            <div id="alertMessage" class="alert @(isSubmitted ? "alert-success" : "alert-danger") alert-fixed">
                @message
            </div>
        }
    </EditForm>
</div>

@code {
    private EquipementRelationService _equipementRelationService;
    private Equipement addEquipement = new()
    {
        Fonctionnalites = new List<Fonctionnalite>(),
        MotsCles = new List<string>(),
        Photos = new List<Photo>()
    };
    private List<Pole_Expertise> pole_expertises = new();
    private List<Type_Equipement> type_Equipements = new();
    private Marque marqueequipement = new();
    private Type_Equipement dernierTypeAjoute;
    private List<Mot_Clef> existingMot = new();
    private List<Fonctionnalite> existingFonctionnalite = new();
    string newCaracteristiqueNom = "";
    int fonctionnaliteId;
    string newCaracteristiqueDesc = "";
    string newMot_Clef = "";
    string motCle = "";
    string fonctionnalite = "";
    private bool isLoading = false;
    bool isSubmitted = false;
    string message = "";
    private const long MaxFileSize = 10_000_000; // 10 Mo
    private string fileErrorMessage;
    Fonctionnalite fonctionnaliteSelectionnee;
    List<Type_Client> typeClients = new();
    List<int> selectedTypeClients = new();
    List<Type_Utilisation> typeUtilisations = new();
    List<int> selectedTypeUtilisations = new();
    void ToggleTypeClient(int id, bool isChecked)
    {
        if (isChecked)
        {
            if (!selectedTypeClients.Contains(id))
                selectedTypeClients.Add(id);
        }
        else
        {
            selectedTypeClients.Remove(id);
        }
    }

    void ToggleTypeUtilisation(int id, bool isChecked)
    {
        if (isChecked)
        {
            if (!selectedTypeUtilisations.Contains(id))
                selectedTypeUtilisations.Add(id);
        }
        else
        {
            selectedTypeUtilisations.Remove(id);
        }
    }


    public class EquipementRelationService
    {
        private readonly HttpClient _http;

        public EquipementRelationService(HttpClient http)
        {
            _http = http;
        }

        public Task LierTypeClients(int equipementId, List<int> ids)
        {
            return _http.PostAsJsonAsync(
                $"api/equipements/{equipementId}/type-clients",
                ids
            );
        }

        public Task LierTypeUtilisations(int equipementId, List<int> ids)
        {
            return _http.PostAsJsonAsync(
                $"api/equipements/{equipementId}/type-utilisations",
                ids
            );
        }
    }

    private string _lastPole_Expertise;
    private string LastPole_Expertise
    {
        get => _lastPole_Expertise;
        set
        {
            _lastPole_Expertise = value;
            JS.InvokeVoidAsync("console.log", $"Changement détecté côté navigateur : {value}");

            if (value == "ajouter")
            {
                OpenModal();
            }
            else
            {
                addEquipement.Nom_Pole_Expertise = value;
            }
        }
    }

    private string _lastTypeEquipement;
    private string LastTypeEquipement
    {
        get => _lastTypeEquipement;
        set
        {
            _lastTypeEquipement = value;
            JS.InvokeVoidAsync("console.log", $"Type sélectionné : {value}");

            if (value != "ajouter")
            {
                addEquipement.Type_Equipement = value;
            }
        }
    }

    private string newTypeEquipement = "";
    protected override async Task OnInitializedAsync()
    {
        _equipementRelationService = new EquipementRelationService(Http);

        pole_expertises = (await pole_expertiseDatas.GetAllAsync()).ToList();
        type_Equipements = (await typeEquipementDatas.GetAllAsync()).ToList();
        marques = (await marqueService.GetAllAsync()).ToList();
        existingMot = (await motService.GetAllAsync()).ToList();
        existingFonctionnalite = (await fonctionnaliteService.GetAllAsync()).ToList();
        typeClients = (await typeClientService.GetAllAsync()).ToList();
        typeUtilisations = (await typeUtilisationService.GetAllAsync()).ToList();
    }

    void AddCaracteristique()
    {
        // Fonctionnalité existante
        if (fonctionnaliteId > 0)
        {
            var fonc = existingFonctionnalite
                .FirstOrDefault(f => f.Id_Fonctionnalite == fonctionnaliteId);

            if (fonc != null &&
                !addEquipement.Fonctionnalites.Any(f => f.Id_Fonctionnalite == fonc.Id_Fonctionnalite))
            {
                addEquipement.Fonctionnalites.Add(fonc);
            }

            fonctionnaliteId = 0;
            return;
        }

        // Nouvelle fonctionnalité
        if (fonctionnaliteId == -1 &&
            !string.IsNullOrWhiteSpace(newCaracteristiqueNom) &&
            !string.IsNullOrWhiteSpace(newCaracteristiqueDesc))
        {
            addEquipement.Fonctionnalites.Add(new Fonctionnalite
            {
                Nom_Fonctionnalite = newCaracteristiqueNom,
                Description = newCaracteristiqueDesc
            });

            newCaracteristiqueNom = "";
            newCaracteristiqueDesc = "";
            fonctionnaliteId = 0;
        }
    }
    void RemoveCaracteristique(Fonctionnalite e)
    {
        addEquipement.Fonctionnalites.Remove(e);
    }
    void AddMot_Clef()
    {
        if (!string.IsNullOrWhiteSpace(newMot_Clef))
        {
            addEquipement.MotsCles.Add(newMot_Clef);
            newMot_Clef = "";
            motCle = "";
        }
        else if (string.IsNullOrWhiteSpace(newMot_Clef) && motCle != "ajouter")
        {
            if (!addEquipement.MotsCles.Contains(motCle))
            {
                addEquipement.MotsCles.Add(motCle);
            }
            motCle = "";
        }
    }
    void RemoveMotCle(string mc)
    {
        addEquipement.MotsCles.Remove(mc);
    }
    private void OnPole_ExpertiseChange(ChangeEventArgs e)
    {
        var selected = e.Value?.ToString();

        // Affiche côté Visual Studio
        Console.WriteLine($"Changement détecté : {selected}");
        System.Diagnostics.Debug.WriteLine($"Changement détecté : {selected}");

        // Affiche côté navigateur (console F12)
        JS.InvokeVoidAsync("console.log", $"Changement détecté côté navigateur 2 : {selected}");

        if (selected == "ajouter")
        {
            OpenModal();
        }
    }

    private void OpenModal()
    {
        JS.InvokeVoidAsync("openModalPole_expertise");
    }

    private void CloseModal()
    {
        JS.InvokeVoidAsync("closeModalPole_expertise");
    }

    // Callback qui sera appelé lorsque la pole_expertise est ajoutée
    private void OnPole_ExpertiseAdded(Pole_Expertise pole_expertise)
    {
        pole_expertises.Add(pole_expertise);
        LastPole_Expertise = pole_expertise.Nom_Pole_Expertise;
        CloseModal();
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        fileErrorMessage = null;
        var files = e.GetMultipleFiles();
        foreach (var file in files)
        {
            if (file.Size > MaxFileSize)
            {
                fileErrorMessage =
                    $"Le fichier « {file.Name} » fait {(file.Size / 1024f / 1024f):0.00} Mo. " + "La taille maximale autorisée est de 10 Mo.";
                continue;
            }

            using var content = new MultipartFormDataContent();
            using var stream = file.OpenReadStream(MaxFileSize);

            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

            content.Add(fileContent, "file", file.Name);

            var response = await Http.PostAsync("https://api-usmbtech-hvevdvgbdwh7aqf5.francecentral-01.azurewebsites.net/api/equipements/upload", content);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<UploadResponse>();

                addEquipement.Photos.Add(new Photo
                {
                    Nom_Photo = file.Name,
                    Url_Photo = result.url
                });
            }
        }
    }

    private void RemovePhoto(Photo photo)
    {
        addEquipement.Photos.Remove(photo);
    }
    public class UploadResponse
    {
        public string url { get; set; }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            // Si aucune photo uploadée → photo par défaut
            if (addEquipement.Photos == null || !addEquipement.Photos.Any())
            {
                addEquipement.Photos = new List<Photo>
            {
                new Photo
                {
                    Nom_Photo = "default-equipement.png",
                    Url_Photo = "/images/No_image_available.png"
                }
            };
            }

            addEquipement.Date_Acquisition = DateTime.Now;
            addEquipement.Actif = true;

            // Transformer les Fonctionnalites en Posseders
            addEquipement.Posseders = addEquipement.Fonctionnalites
                .Select(f => new Posseder
                {
                    Id_Fonctionnalite = f.Id_Fonctionnalite
                    // Id_Equipement sera rempli côté backend
                }).ToList();

            await JS.InvokeVoidAsync("console.log", "Types clients sélectionnés :", selectedTypeClients);
            await JS.InvokeVoidAsync("console.log", "Types d’utilisation sélectionnés :", selectedTypeUtilisations);

            var response = await Http.PostAsJsonAsync("https://api-usmbtech-hvevdvgbdwh7aqf5.francecentral-01.azurewebsites.net/api/Equipements", addEquipement);

            if (!response.IsSuccessStatusCode)
            {
                throw new Exception("Erreur lors de l'ajout de l'équipement");
            }

            var createdEquipement = await response.Content.ReadFromJsonAsync<Equipement>();

            var equipementId = createdEquipement.Id_Equipement;

            // Types clients
            if (selectedTypeClients.Any())
            {
                await _equipementRelationService.LierTypeClients(equipementId, selectedTypeClients);
            }

            // Types d’utilisation
            if (selectedTypeUtilisations.Any())
            {

                await _equipementRelationService.LierTypeUtilisations(equipementId, selectedTypeUtilisations);
            }

            addEquipement = createdEquipement;
            isSubmitted = true;
            await ShowAlert("Équipement ajouté avec succès");
        }
        catch (Exception ex)
        {
            isSubmitted = false;
            await ShowAlert("Il y a eu une erreur lors de l'ajout de l'équipement");
            await JS.InvokeVoidAsync("console.error", ex.ToString());
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ShowAlert(string msg)
    {
        message = msg;
        StateHasChanged();

        await Task.Delay(3000); // attend 3 secondes

        message = null;         // efface le message
        StateHasChanged();      // met à jour
        if (isSubmitted)
        {
            Navigation.NavigateTo($"/equipement/{addEquipement.Id_Equipement}");
        }
    }

    private void pole_expertiseRotation(string SelectedPole_Expertise)
    {
        addEquipement.Nom_Pole_Expertise = SelectedPole_Expertise;
    }
    private void TypeRotation(string SelectedType)
    {
        addEquipement.Type_Equipement = SelectedType;
    }

    void AddTypeEquipement()
    {
        if (!string.IsNullOrWhiteSpace(newTypeEquipement))
        {
            var nouveauType = new Type_Equipement { Nom_Type = newTypeEquipement };
            type_Equipements.Add(nouveauType);

            // Sélectionne automatiquement le type ajouté
            LastTypeEquipement = newTypeEquipement;
            addEquipement.Type_Equipement = newTypeEquipement;

            dernierTypeAjoute = nouveauType;
            newTypeEquipement = "";
        }
    }

    void RemoveTypeEquipement(Type_Equipement t)
    {
        type_Equipements.Remove(t);
        if (dernierTypeAjoute == t)
        {
            dernierTypeAjoute = null;
        }
    }

    private string _lastMarque;
    private string newMarque = "";
    private List<Marque> marques = new();
    private Marque derniereMarqueAjoutee;
    private string LastMarque
    {
        get => _lastMarque;
        set
        {
            _lastMarque = value;
            JS.InvokeVoidAsync("console.log", $"Marque sélectionnée : {value}");

            if (value != "ajouter")
            {
                addEquipement.Nom_Marque = value;
            }
        }
    }

    void AddMarque()
    {
        if (!string.IsNullOrWhiteSpace(newMarque))
        {
            var nouvelleMarque = new Marque { Nom_Marque = newMarque };
            marques.Add(nouvelleMarque);

            LastMarque = newMarque;
            addEquipement.Nom_Marque = newMarque;
            derniereMarqueAjoutee = nouvelleMarque;
            newMarque = "";
        }
    }

    void RemoveMarque(Marque m)
    {
        marques.Remove(m);
        if (derniereMarqueAjoutee == m)
        {
            derniereMarqueAjoutee = null;
        }
    }
}
