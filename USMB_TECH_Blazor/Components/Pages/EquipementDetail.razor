@page "/equipement/{Id:int}"
@inject Service.IMainService<Equipement, int> dataRepository
@inject NavigationManager Navigation
@inject IJSRuntime JS

<HeadContent>
    <link href="css/PageDetail.css" rel="stylesheet" />
</HeadContent>

<PageTitle>Détails Equipement</PageTitle>

@if (!string.IsNullOrEmpty(deleteMessage))
{
    <div class="alert @(deleteSuccess ? "alert-success" : "alert-danger") alert-fixed">
        @deleteMessage
    </div>
}

@if (equipement == null)
{
    <p>Chargement...</p>
}
else
{
    <div class="container">
        <!-- ========== COLONNE GAUCHE ========== -->
        <div class="col-left">

            <!-- Nom équipement -->
            <section>
                <h2>@equipement.Nom_Equipement</h2>
            </section>

            <!-- Image -->
            <section class="center-grid">
                <div class="center-item">
                    @foreach (Photo photo in equipement.Photos)
                    {
                        <img src=@photo.Url_Photo alt="photo équipement" />
                    }
                </div>
            </section>

            @* <!-- Ajout du modèle 3D avec Blazor3D -->
            <section>
                <h3>Modèle 3D de l'Équipement</h3>
                <Blazor3D.Model3DViewer 
                    ModelUrl="https://skfb.ly/pEunL"
                    Width="100%" 
                    Height="500px" />
            </section> *@

            <!-- Utilisation -->
            <section>
                <h3>UTILISATION - DOMAINE D’APPLICATION</h3>
                @if (equipement.Exemple_Utilisations != null && equipement.Exemple_Utilisations.Any())
                {
                    @foreach (var exemple in equipement.Exemple_Utilisations)
                    {
                        <p><strong>@exemple.Nom_Utilisation</strong></p>
                        <p>@exemple.Description_Utilisation</p>
                    }
                }
                else
                {
                    <p>Aucune utilisation renseignée.</p>
                }
            </section>

            <!-- Caractéristiques -->
            <section>
                <h3>CARACTÉRISTIQUES TECHNIQUES</h3>
                <p>@equipement.Description_Technique</p>
            </section>
        </div>

        <!-- ========== COLONNE CENTRALE ========== -->
        <div class="col-center">
            <section>
                <h3>MOTS CLÉS</h3>
                <ul class="list-style">
                    @if (equipement.Pole_ExpertiseNavigation?.Specifiers != null)
                    {
                        @foreach (var spec in equipement.Pole_ExpertiseNavigation.Specifiers)
                        {
                            if (spec.Mot_ClefNavigation != null)
                            {
                                <li>@spec.Mot_ClefNavigation.Nom_Mot_Clef</li>
                            }
                        }
                    }
                </ul>

                <h3>TYPE EQUIPEMENTS</h3>
                <ul class="list-style">
                    @if (equipement.Type_EquipementNavigation != null)
                    {
                        <li>@equipement.Type_EquipementNavigation.Nom_Type</li>
                    }
                </ul>
            </section>
        </div>

        <!-- ========== COLONNE DROITE ========== -->
        <div class="col-right">
            <div class="info-block">
                <h4>Domaine d'excellence :</h4>
                <div class="btn-blue" @onclick="@(() => RetourDomaineExcellence(equipement.Pole_ExpertiseNavigation.Domaine_ExcellenceNavigation.Id_Domaine_Excellence))">
                    @equipement.Pole_ExpertiseNavigation?.Domaine_ExcellenceNavigation?.Intitule_Domaine_Excellence
                </div>
            </div>

            @*   <div class="info-block">
                <h4>Localisation :</h4>
                <div class="btn-blue">Le Bourget du Lac (ce n'est pas la bonne donnée)'</div>
            </div> *@

            <div class="info-block">
                <h4>Pôle d'expertise :</h4>
                <div class="btn-blue" @onclick="@(() => RetourListe(equipement.Id_Pole_Expertise))">
                    @equipement.Pole_ExpertiseNavigation?.Nom_Pole_Expertise
                </div>
            </div>

            <FormulaireContact />
        </div>
    </div>

    <button class="btn btn-info mb-3" @onclick="() => GoToUpdate(equipement.Id_Equipement)">
        Modifier
    </button>
    <button class="btn btn-danger mb-3" @onclick="() => DeleteEquipement(equipement.Id_Equipement)">
        Supprimer
    </button>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Equipement? equipement;
    private string thematique;

    // ----------- ALERTES SUPPRESSION -----------
    private string deleteMessage = null;
    private bool deleteSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        equipement = await dataRepository.GetByIdAsync(Id);
        thematique = equipement.Thematiques.Select(t => t.Nom_Thematique).FirstOrDefault();
    }

    // ----------- SUPPRESSION AVEC CONFIRMATION + MESSAGE -----------
    private async Task DeleteEquipement(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>(
            "confirm",
            "Voulez-vous vraiment supprimer cet équipement ?"
        );

        if (!confirm)
            return;

        try
        {
            await dataRepository.DeleteAsync(id);
            deleteSuccess = true;
            await ShowDeleteAlert("Équipement supprimé avec succès");
            Navigation.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            deleteSuccess = false;
            await ShowDeleteAlert($"Erreur lors de la suppression : {ex.Message}");
        }
    }

    // ----------- AFFICHAGE & AUTO-DISPARITION -----------
    private async Task ShowDeleteAlert(string msg)
    {
        deleteMessage = msg;
        StateHasChanged();
        await Task.Delay(3000);
        deleteMessage = null;
        StateHasChanged();
    }

    private void RetourListe(int idPole_Expertise)
    {
        Navigation.NavigateTo($"/pole_expertise/{idPole_Expertise}");
    }

    private void GoToUpdate(int id)
    {
        Navigation.NavigateTo($"/equipement/edit/{id}", true);
    }


    private void RetourDomaineExcellence(int idDomaineExcellence)
    {
        Navigation.NavigateTo($"/DomaineExcellence/{idDomaineExcellence}");
    }
}