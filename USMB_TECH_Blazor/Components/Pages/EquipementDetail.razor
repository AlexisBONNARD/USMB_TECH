@page "/equipement/{Id:int}"
@inject Service.IMainService<Equipement,int> dataRepository
@inject NavigationManager Navigation

<PageTitle>Détails Equipement</PageTitle>

<h1>Détails de l'Equipement</h1>

@if (equipement == null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <div class="equipement-wrapper">

        <p class="card-text">
            Equipement : <strong>@equipement.Nom_Equipement</strong>
        </p>

        <p class="card-text"><strong>Num :</strong> @equipement.Num_Immobilisation</p>

        <img src="images/logo_usmb.png" class="usmb-logo" />
        
        <!-- Exemples d'utilisation -->
        <p class="card-text"><strong>Exemples d’Utilisation :</strong></p>

        @if (equipement.Exemple_Utilisations != null && equipement.Exemple_Utilisations.Any())
        {
            @foreach (var exemple in equipement.Exemple_Utilisations)
            {
                <div class="exemple-bloc">
                    <p><strong>@exemple.Nom_Utilisation</strong></p>
                    <p>@exemple.Description_Utilisation</p>
                </div>
            }
        }
        else
        {
            <p>Aucun exemple trouvé.</p>
            Console.WriteLine("exemple non trouvé !");
        }

        <!-- Caractéristiques techniques -->
        <p class="card-text"><strong>Caractéristiques techniques :</strong></p>
        <p id="equipementDesc">@equipement.Description_Technique</p>

        <!-- 🔹 Plateforme depuis plateformeNavigation -->
        @if (equipement.PlateformeNavigation != null)
        {
            <div class="plateforme-box">
                <strong>Plateforme :</strong> @equipement.PlateformeNavigation.Nom_Plateforme
                @if (equipement.PlateformeNavigation?.Specifiers != null && equipement.PlateformeNavigation.Specifiers.Any(s => s.Mot_ClefNavigation != null))
                {
                    <p><strong>Mots-clés :</strong></p>

                    @foreach (var specifier in equipement.PlateformeNavigation.Specifiers)
                    {
                        if (specifier.Mot_ClefNavigation != null)
                        {
                            <p>- @specifier.Mot_ClefNavigation.Nom_Mot_Clef</p>
                        }
                    }
                }
            </div>
        }
        else
        {
            <p><em>Plateforme non trouvée.</em></p>
        }

        <!-- Statuts -->
        <p class="card-text"><strong>Actif :</strong> @(equipement.Actif ? "Oui" : "Non")</p>

        <!-- Bouton retour -->
        <button class="btn btn-primary mt-3"
                @onclick="@(() => RetourListe(equipement.Id_Plateforme))">
            Voir Plateforme @(equipement.Id_Plateforme)
        </button>

    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Equipement? equipement;

    protected override async Task OnInitializedAsync()
    {
        equipement = await dataRepository.GetByIdAsync(Id);

        if (equipement != null)
        {
            Console.WriteLine($"Equipement chargé : {equipement.Id_Equipement}");

        }
        else
        {
            Console.WriteLine("Équipement non trouvé !");
        }
    }

    private void RetourListe(int idPlateforme)
    {
        Navigation.NavigateTo($"/plateforme/{idPlateforme}");
    }
}