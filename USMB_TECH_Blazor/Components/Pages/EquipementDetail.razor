@page "/Equipement/{Id:int}"
@inject Service.IMainService<Equipement,int> dataRepository
@inject NavigationManager Navigation

<PageTitle>Détails Equipement</PageTitle>

<h1>Détails de l'Equipement</h1>

@if (equipement == null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <p class="card-text"><strong>Equipement @(equipement.Num_Immobilisation) @(equipement.Nom_Equipement) :</strong></p>
    <img src="images/logo_usmb.png" alt="Logo Université Savoie Mont Blanc" class="usmb-logo" />

    <!-- Afficher tous les exemples d'utilisation -->
    <p class="card-text"><strong>Exemples d'Utilisation :</strong></p>
    @* @foreach (var exemple in equipement.Exemple_Utilisations)
    {
        <p><strong>@exemple.Nom_Utilisation :</strong> @exemple.Description_Utilisation</p>
    } *@

    <p class="card-text"><strong>caractéristiques techniques :</strong> <p id="equipementDesc">@equipement.Description_Technique</p></p>

    @* @equipement.Id_Plateforme
    @foreach (var plateforme in equipement.Id_Plateforme)
    {
        <div>
            <strong>Plateforme :</strong> @plateforme.Nom_Plateforme
            @foreach (var motClef in plateforme.MotsCles)
            {
                <p><strong>Mot-clé :</strong> @motClef.Nom_Mot_Clef</p>
            }
        </div>
    } *@

    <p class="card-text"><strong>En réappro :</strong> @(equipement.Actif ? "Oui" : "Non")</p>
    <button class="btn btn-primary mt-2" @onclick="@RetourListe">Retour à la liste</button>
}

@code {
    [Parameter]
    public int Id { get; set; }
    private Equipement? equipement;
    //private Plateforme? plateforme;

    // Dans la classe EquipementForecast
    public string Exemple_Utilisation_Nom { get; set; }
    public string Exemple_Utilisation_Description { get; set; }

    protected override async Task OnInitializedAsync()
    {
        equipement = await dataRepository.GetByIdAsync(Id);
        Console.WriteLine(equipement.Id_Equipement);

        // Récupérer les plateformes liées à cet équipement
        var Id_Plateformes = equipement.Id_Plateforme;
        var plateforme = await dataRepository.GetByIdAsync(Id_Plateformes);
        Console.WriteLine(plateforme.Id_Plateforme);

        // Récupérer tous les exemples d'utilisation associés à cet équipement
        // var exemplesUtilisation = equipement.Exemple_Utilisations;
        // foreach (var exemple in exemplesUtilisation)
        // {
        //     Console.WriteLine($"Exemple Utilisation: {exemple.Nom_Utilisation}");
        //     Tu peux ajouter ces valeurs dans une collection ou les afficher directement
        //     Exemple_Utilisation_Nom = exemple.Nom_Utilisation;
        //     Exemple_Utilisation_Description = exemple.Description_Utilisation;
        // }
    }

    private async Task RetourListe()
    {
        Navigation.NavigateTo("/equipements");
    }
    }
}