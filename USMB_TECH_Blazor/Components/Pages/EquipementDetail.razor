@page "/equipement/{Id:int}"
@inject Service.IMainService<Equipement,int> dataRepository
@inject Service.IMainService<Plateforme,int> plateformeRepository
@inject NavigationManager Navigation

<PageTitle>Détails Equipement</PageTitle>

<h1>Détails de l'Equipement</h1>

@if (equipement == null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <p class="card-text">Equipement <strong> @(equipement.Nom_Equipement) :</strong></p>
    <p class="card-text"><strong>Num : </strong>@(equipement.Num_Immobilisation)</p>
    <img src="images/logo_usmb.png" alt="Logo Université Savoie Mont Blanc" class="usmb-logo" />

    <!-- Afficher tous les exemples d'utilisation -->
    <p class="card-text"><strong>Exemples d'Utilisation :</strong></p>
    @foreach (var exemple in equipement.Exemple_Utilisations)
    {
        <p><strong>@exemple.Nom_Utilisation :</strong> @exemple.Description_Utilisation</p>
    }

    <p class="card-text"><strong>Caractéristiques techniques :</strong> <p id="equipementDesc">@equipement.Description_Technique</p></p>

    @if (plateformeLiee != null)
    {
        <div>
            <strong>Plateforme :</strong> @plateformeLiee.Nom_Plateforme
            @* @if (plateformeLiee.MotsCles?.Any() == true)
            {
                @foreach (var motClef in plateformeLiee.MotsCles)
                {
                    <p><strong>Mot-clé :</strong> @motClef.Nom_Mot_Clef</p>
                }
            } *@
        </div>
    }
    else
    {
        <p><em>Aucune plateforme liée trouvée.</em></p>
    }

    <p class="card-text"><strong>Actif :</strong> @(equipement.Actif ? "Oui" : "Non")</p>

    <!-- Bouton pour retourner à la liste des plateformes -->
    <button class="btn btn-primary mt-2" @onclick="@(() => RetourListe(equipement.Id_Plateforme))">Voir Plateforme @(equipement.Id_Plateforme)</button>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private Equipement? equipement;
    private Plateforme? plateformeLiee;

    // Dans la classe EquipementForecast
    public string Exemple_Utilisation_Nom { get; set; }
    public string Exemple_Utilisation_Description { get; set; }

    protected override async Task OnInitializedAsync()
    {
        equipement = await dataRepository.GetByIdAsync(Id);
        if (equipement != null)
        {
            Console.WriteLine($"Equipement chargé: {equipement.Id_Equipement}");

            // Charger la plateforme associée
            plateformeLiee = await plateformeRepository.GetByIdAsync(equipement.Id_Plateforme);

            if (plateformeLiee != null)
                Console.WriteLine($"Plateforme chargée: {plateformeLiee.Nom_Plateforme}");
            else
                Console.WriteLine("Plateforme non trouvée pour cet équipement.");

            // Exemples d'utilisation
            foreach (var exemple in equipement.Exemple_Utilisations)
            {
                Console.WriteLine($"Exemple Utilisation: {exemple.Nom_Utilisation}");
                Exemple_Utilisation_Nom = exemple.Nom_Utilisation;
                Exemple_Utilisation_Description = exemple.Description_Utilisation;
            }
        }
    }

    private async Task RetourListe(int IdPlateforme)
    {
        // Naviguer vers la page plateforme spécifique
        Navigation.NavigateTo($"/plateforme/{IdPlateforme}");
    }
}