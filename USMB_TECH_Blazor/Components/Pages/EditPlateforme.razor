@page "/plateforme/edit/{Id:int}"
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject Service.IMainService<Prestation,int> prestationDatas
@using USMB_TECH.Models


<h2 class="add_platform">Modifier la plateforme</h2>

@if (plateforme == null)
{
    <p>Chargement...</p>
}
else
{
    <div class="page-container">
        <EditForm Model="@plateforme" OnValidSubmit="SubmitPlateforme">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <!-- Infos générales -->
            <h4 class="add_platform">Infos générales</h4>
            <label>Nom plateforme *</label>
            <InputText class="form-control mb-2" @bind-Value="plateforme.Nom_Plateforme" />
            <ValidationMessage For="@(() => plateforme.Nom_Plateforme)" />

            <label>Description *</label>
            <InputTextArea class="form-control mb-2" @bind-Value="plateforme.Description_Plateforme" />
            <ValidationMessage For="@(() => plateforme.Description_Plateforme)" />

            <label>Nom contenu *</label>
            <InputText class="form-control mb-2" @bind-Value="plateforme.Nom_Contenu" />
            <ValidationMessage For="@(() => plateforme.Nom_Contenu)" />

            <label>URL contenu *</label>
            <InputText class="form-control mb-2" @bind-Value="plateforme.Url_Contenu" />
            <ValidationMessage For="@(() => plateforme.Url_Contenu)" />

            <label>Description contenu *</label>
            <InputTextArea class="form-control mb-2" @bind-Value="plateforme.Description_Contenu" />
            <ValidationMessage For="@(() => plateforme.Description_Contenu)" />

            <label class="mt-2">Active ?</label>
            <InputSelect class="form-control mb-2" @bind-Value="plateforme.Actif">
                <option value="true">Oui</option>
                <option value="false">Non</option>
            </InputSelect>

            <hr />
            <h4 class="add_platform">Équipements</h4>
            @foreach (var eq in plateforme.Equipements)
            {
                <div class="mb-3 border p-2">
                    <label>Nom équipement</label>
                    <InputText class="form-control mb-1" @bind-Value="eq.Nom_Equipement" />

                    <label>Numéro d'immobilisation *</label>
                    <InputText class="form-control mb-1" @bind-Value="eq.Num_Immobilisation" />

                    <label>Date acquisition</label>
                    <InputDate class="form-control mb-1" @bind-Value="eq.Date_Acquisition" />

                    <label>Prix achat</label>
                    <InputNumber class="form-control mb-1" @bind-Value="eq.Prix_Achat" />

                    <label>Prix revient</label>
                    <InputNumber class="form-control mb-1" @bind-Value="eq.Prix_Revient" />

                    <label>Description technique</label>
                    <InputTextArea class="form-control mb-1" @bind-Value="eq.Description_Technique" />

                    <label>Disponibilité</label>
                    <InputCheckbox class="form-check-input" @bind-Value="eq.Disponibilite" />

                    <label>Autonomie</label>
                    <InputCheckbox class="form-check-input" @bind-Value="eq.Autonomie" />

                    <label>Utilisable chez le client</label>
                    <InputCheckbox class="form-check-input" @bind-Value="eq.Utilisable_Chez_Le_Client" />

                    <label>Actif</label>
                    <InputCheckbox class="form-check-input" @bind-Value="eq.Actif" />
                </div>
            }

            <!-- Tu peux réutiliser ici les blocs Photos, Mots-clés, Thématiques, Exemples, Prestations comme dans AddPlateforme -->

            <hr />
            <button class="btn btn-primary mt-3" type="submit">Mettre à jour</button>
        </EditForm>
    </div>
}

@if (!string.IsNullOrEmpty(message))
{
    <div id="alertMessage" class="alert @(isSubmitted ? "alert-success" : "alert-danger") alert-fixed">
        @message
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    Plateforme? plateforme;
    private List<Prestation> prestations = new();

    bool isSubmitted = false;
    string message = "";

    protected override async Task OnInitializedAsync()
    {
        prestations = (await prestationDatas.GetAllAsync()).ToList();
        plateforme = await Http.GetFromJsonAsync<Plateforme>($"https://localhost:7093/api/plateformes/{Id}");
    }

    async Task SubmitPlateforme()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"https://localhost:7093/api/plateformes/{Id}", plateforme);

            if (response.IsSuccessStatusCode)
            {
                isSubmitted = true;
                await ShowAlert("Plateforme mise à jour avec succès ✅");
            }
            else
            {
                isSubmitted = false;
                await ShowAlert("Erreur lors de la mise à jour ❌");
            }
        }
        catch (Exception ex)
        {
            isSubmitted = false;
            await ShowAlert($"Erreur: {ex.Message}");
        }
    }

    async Task ShowAlert(string msg)
    {
        message = msg;
        await Task.Delay(3000);
        message = "";
    }
}
