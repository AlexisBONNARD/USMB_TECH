@page "/laboratoire/{Id}"
@inject IMainService<Laboratoire, string> dataRepository
@inject NavigationManager Navigation
@inject AdminState AdminState
@inject IJSRuntime JS
@inject HttpClient Http


<HeadContent>
    <link href="css/PageDetail.css" rel="stylesheet" />
</HeadContent>

<PageTitle>Détails Laboratoire</PageTitle>

@if (laboratoire is null)
{
    <p>Chargement en cours</p>
}
else
{
    <div class="container">
        <!-- ========= COLONNE GAUCHE ========= -->
        <div class="col-left">
            <section>
                <h2>@laboratoire.Nom_Long (@laboratoire.Nom_Court)</h2>
            </section>
            <div class="banner-photo">
                <Carousel Photos="@laboratoire.Photos" />
            </div>
            <section>
                <h3>Adresse</h3>
                <div id="map"
                     style="height:400px; width:100%">
                </div>

                <ul class="list-style">
                    <p>Adresse du laboratoire : @adresseLabo.Complement_Rue_Adresse @adresseLabo.Rue_Adresse, @adresseLabo.Ville_Adresse @adresseLabo.Code_Postal_Adresse, @adresseLabo.Pays_Adresse </p>
                    @* <p>Adresse du campus : @adresseCampus.Complement_Rue_Adresse @adresseCampus.Rue_Adresse, @adresseCampus.Ville_Adresse @adresseCampus.Code_Postal_Adresse, @adresseCampus.Pays_Adresse </p> *@
                </ul>
            </section>
        </div>

        <!-- ========= COLONNE CENTRALE ========= -->
        <div class="col-center">
            <section>
                <h3>NOS CONTACTS</h3>

                <div class="center-grid">
                    @foreach (Contact_USMB contact in laboratoire.Contacts)
                    {
                        <div class="center-item">
                            <p>@contact.Prenom_Contact @contact.Nom_Contact</p>
                            <p>Mail : @contact.Mail</p>
                            <p>Numéro de téléphone : @contact.Telephone</p>
                        </div>
                    }
                </div>
            </section>
        </div>

        <!-- ========= COLONNE DROITE ========= -->
        <div class="col-right">

            <FormulaireContact />
        </div>
    </div>
    @if (AdminState.IsAdmin)
    {
        <button class="btn btn-info mb-3" @onclick="() => GoToUpdate(laboratoire.Nom_Court)">
            Modifier
        </button>
        <button class="btn btn-danger mb-3" @onclick="() => DeleteLaboratoire(laboratoire.Nom_Court)">
            Supprimer
        </button>
    }
}

@code {
    [Parameter]
    public string Id { get; set; }
    public Laboratoire laboratoire = new Laboratoire();
    public Adresse adresseLabo = new Adresse();
    public Adresse adresseCampus = new Adresse();
    public IEnumerable<Pole_Expertise> pole_expertises;
    private string deleteMessage = null;
    private bool deleteSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        laboratoire = await dataRepository.GetByIdAsync(Id);
        adresseCampus = laboratoire.Adresse_campusNavigation;
        adresseLabo = laboratoire.Adresse_laboNavigation;
        pole_expertises = laboratoire.Gerers.Select(g => g.Pole_ExpertiseNavigation).ToList();

        // Dès que l'adresse est chargée, on initialise la carte
        await InitMapIfAdresseReady();
    }

    private async Task InitMapIfAdresseReady()
    {
        if (adresseLabo?.Rue_Adresse == null ||
            adresseLabo.Ville_Adresse == null ||
            adresseLabo.Pays_Adresse == null ||
            adresseLabo.Code_Postal_Adresse == null)
        {
            Console.WriteLine("Adresse incomplète, pas de géocodage.");
            return;
        }

        var coords = await GetCoordsFromAdresse();
        if (coords.HasValue)
        {
            await JS.InvokeVoidAsync("initMap", coords.Value.lat, coords.Value.lon);
        }
    }


    private async Task<(double lat, double lon)?> GetCoordsFromAdresse()
    {
        if (adresseLabo?.Rue_Adresse == null ||
            adresseLabo.Ville_Adresse == null ||
            adresseLabo.Pays_Adresse == null ||
            adresseLabo.Code_Postal_Adresse == null)
            return null;

        // URL avec paramètres séparés
        var url = $"/api/geocode?" +
                  $"street={Uri.EscapeDataString(adresseLabo.Rue_Adresse)}&" +
                  $"city={Uri.EscapeDataString(adresseLabo.Ville_Adresse)}&" +
                  $"country={Uri.EscapeDataString(adresseLabo.Pays_Adresse)}&" +
                  $"postalcode={Uri.EscapeDataString(adresseLabo.Code_Postal_Adresse)}";

        Console.WriteLine($"URL de géocodage : {url}");

        var result = await Http.GetFromJsonAsync<List<NominatimResult>>(url);

        if (result == null || result.Count == 0)
            return null;

        return (
            double.Parse(result[0].lat, CultureInfo.InvariantCulture),
            double.Parse(result[0].lon, CultureInfo.InvariantCulture)
        );
    }



    private void RetourListe(int id, string nomChemin)
    {
        Navigation.NavigateTo($"/{nomChemin}/{id}");
    }

    private async Task DeleteLaboratoire(string id)
    {
        bool confirm = await JS.InvokeAsync<bool>(
            "confirm",
            "Voulez-vous vraiment supprimer ce domaine d'excellence ?"
        );

        if (!confirm)
            return;

        try
        {
            await dataRepository.DeleteAsync(id);

            deleteSuccess = true;
            await ShowDeleteAlert("Domaine supprimé avec succès ✅");
            Navigation.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            deleteSuccess = false;
            await ShowDeleteAlert($"Erreur lors de la suppression ❌ : {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || adresseLabo == null)
            return;

        var coords = await GetCoordsFromAdresse();

        if (coords.HasValue)
        {
            await JS.InvokeVoidAsync(
                "initMap",
                coords.Value.lat,
                coords.Value.lon
            );
        }
    }



    private void GoToUpdate(string id)
    {
        Navigation.NavigateTo($"/laboratoire/edit/{id}", true);
    }

    private async Task ShowDeleteAlert(string msg)
    {
        deleteMessage = msg;
        StateHasChanged();

        await Task.Delay(3000);

        deleteMessage = null;
        StateHasChanged();
    }
}
