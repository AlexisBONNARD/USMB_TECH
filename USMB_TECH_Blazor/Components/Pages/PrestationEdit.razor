@page "/prestation/edit/{Id:int}"

@inject NavigationManager Navigation
@inject HttpClient Http
@inject IMainService<PrestationUpdateModel, int> prestationService
@inject IMainService<Domaine_Excellence, int> domaineService
@inject IMainService<Type_Prestation, int> typeService
@inject IMainService<Unite_Oeuvre, int> uniteService
@inject IMainService<Mot_Clef, int> motCleService
@inject IMainService<Contact_USMB, int> contactService

@using USMB_TECH_Blazor.Models

<h2 class="add_style">Modifier la prestation</h2>

@if (prestationUpdate == null)
{
    <p>Chargement...</p>
}
else
{
    <div class="page-container">
        <EditForm Model="@prestationUpdate" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <h4 class="add_style">Informations générales</h4>

            <label>Intitulé *</label>
            <InputText class="form-control mb-2"
                       @bind-Value="prestationUpdate.Intitule_Prestation" />

            <label>Description</label>
            <InputTextArea class="form-control mb-2"
                           @bind-Value="prestationUpdate.Description_Prestation" />

            <label>Nom court</label>
            <InputText class="form-control mb-2"
                       @bind-Value="prestationUpdate.Nom_Court" />

            <label>Active ?</label>
            <InputSelect class="form-control mb-3"
                         @bind-Value="prestationUpdate.Actif">
                <option value="true">Oui</option>
                <option value="false">Non</option>
            </InputSelect>

            <h4 class="add_style">Références</h4>

            <label>Domaine *</label>
            <InputSelect class="form-control mb-2"
                         @bind-Value="prestationUpdate.Id_Domaine_Excellence">
                <option value="0">...</option>
                @foreach (var d in domaines)
                {
                    <option value="@d.Id_Domaine_Excellence">@d.Intitule_Domaine_Excellence</option>
                }
            </InputSelect>

            <label>Type *</label>
            <InputSelect class="form-control mb-2"
                         @bind-Value="prestationUpdate.Id_Type_Prestation">
                <option value="0">...</option>
                @foreach (var t in types)
                {
                    <option value="@t.Id_Type_Prestation">@t.Nom_Type_Prestation</option>
                }
            </InputSelect>

            <label>Unité *</label>
            <InputSelect class="form-control mb-3"
                         @bind-Value="prestationUpdate.Id_Unite_Oeuvre">
                <option value="0">...</option>
                @foreach (var u in unites)
                {
                    <option value="@u.Id_Unite_Oeuvre">@u.Nom_Unite_Oeuvre</option>
                }
            </InputSelect>


            <hr />
            <h4 class="add_style">Contact associé</h4>
            <InputSelect class="form-control mb-3"
                         @bind-Value="prestationUpdate.Id_Contact">
                <option value="0">...</option>
                @foreach (var c in contacts)
                {
                    <option value="@c.Id_Contact">
                        @c.Prenom_Contact @c.Nom_Contact
                    </option>
                }
            </InputSelect>

            <hr />
            <h4 class="add_style">Mots-clés *</h4>

            <InputSelect class="form-control mb-2"
                         @bind-Value="selectedMotCleId">
                <option value="0">...</option>
                @foreach (var mc in motsClesExistants)
                {
                    <option value="@mc.Id_Mot_Clef">@mc.Nom_Mot_Clef</option>
                }
            </InputSelect>

            <button type="button"
                    class="btn btn-secondary btn-sm"
                    disabled="@(selectedMotCleId == 0)"
                    @onclick="AddMotCle">
                Ajouter ce mot-clé
            </button>

            <ul class="add_style mt-2">
                @foreach (var id in prestationUpdate.MotCleIds)
                {
                    var mc = motsClesExistants.FirstOrDefault(m => m.Id_Mot_Clef == id);
                    if (mc != null)
                    {
                        <li>
                            @mc.Nom_Mot_Clef
                            <button type="button"
                                    class="btn btn-sm btn-danger ms-2"
                                    @onclick="() => RemoveMotCle(id)">
                                Supprimer
                            </button>
                        </li>
                    }
                }
            </ul>


            <hr />
            <button type="submit" class="btn btn-primary mt-3">
                Mettre à jour
            </button>
        </EditForm>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private PrestationUpdateModel? prestationUpdate;

    private List<Domaine_Excellence> domaines = new();
    private List<Type_Prestation> types = new();
    private List<Unite_Oeuvre> unites = new();
    private List<Mot_Clef> motsClesExistants = new();
    private List<Contact_USMB> contacts = new();



    protected override async Task OnInitializedAsync()
    {
        prestationUpdate = await prestationService.GetByIdAsync(Id);

        // synchroniser les IDs avec les Precisers
        prestationUpdate.MotCleIds = prestationUpdate.Precisers?
            .Select(p => p.Id_Mot_Clef)
            .ToList() ?? new List<int>();

        domaines = (await domaineService.GetAllAsync()).ToList();
        types = (await typeService.GetAllAsync()).ToList();
        unites = (await uniteService.GetAllAsync()).ToList();
        motsClesExistants = (await motCleService.GetAllAsync()).ToList();
        contacts = (await contactService.GetAllAsync()).ToList();
    }


    private int selectedMotCleId;

    private void AddMotCle()
    {
        if (selectedMotCleId != 0 && prestationUpdate != null && !prestationUpdate.MotCleIds.Contains(selectedMotCleId))
        {
            prestationUpdate.MotCleIds.Add(selectedMotCleId);
            selectedMotCleId = 0;
        }
    }

    private void RemoveMotCle(int id)
    {
        prestationUpdate?.MotCleIds.Remove(id);
    }


    private async Task Submit()
    {
        if (prestationUpdate != null)
        {
            await prestationService.UpdateAsync(prestationUpdate);
            Navigation.NavigateTo($"/prestation/{Id}");
        }
    }





}
