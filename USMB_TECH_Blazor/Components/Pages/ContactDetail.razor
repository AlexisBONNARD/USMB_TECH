@page "/contact/{contactId:int}"
@inject IMainService<Contact_USMB,int> ContactService
@inject NavigationManager Navigation
@inject AdminState AdminState
@inject IJSRuntime JS


<HeadContent>
    <link href="css/PageDetail.css" rel="stylesheet" />
</HeadContent>

<PageTitle>Détails Contact</PageTitle>

@if (contact == null)
{
    <p>Loading...</p>
}
else
{
    <div class="container">
        <!-- ========= COLONNE GAUCHE ========= -->
        <div class="col-left">
            <section>
                <h2>Informations générales</h2>
                <p>Nom : @contact.Nom_Contact </p>
                <p>Prénom : @contact.Prenom_Contact</p>
            </section>

            <section>
                <h2>Moyen pour contacter le contact</h2>
                <p>Mail : @contact.Mail </p>
                <p>Téléphone : @contact.Telephone </p>
            </section>
        </div>

        <!-- ========= COLONNE CENTRALE ========= -->
        <div class="col-center">
            <section>
                <h2>Laboratoire</h2>

                <div class="center-grid">
                    @if (contact.Nom_Court != null)
                    {
                        <div class="center-item" @onclick="@(() => RetourListeStr(contact.Nom_Court, "laboratoire"))">
                            @if (contact.LaboratoireNavigation.Photos != null && contact.LaboratoireNavigation.Photos.Any())
                            {
                                <img src="@contact.LaboratoireNavigation.Photos.FirstOrDefault().Url_Photo" alt="@contact.LaboratoireNavigation.Photos.FirstOrDefault().Nom_Photo" />
                            }

                            <p>@contact.Nom_Court</p>
                            <p>@contact.LaboratoireNavigation.Nom_Long</p>
                        </div>
                    }
                    else
                    {
                        <p>pas de Laboratoire</p>
                    }
                </div>
                <h2>Fonction</h2>

                <div class="center-grid">
                    @if (contact.Id_Fonction != null)
                    {
                        <div class="center-item">
                            <p>@contact.FonctionNavigation.Nom_Fonction</p>
                        </div>
                    }
                    else
                    {
                        <p>pas de Fonction</p>
                    }
                </div>
            </section>
        </div>

        <!-- ========= COLONNE DROITE ========= -->
        <div class="col-right">

            @* <div class="info-block">
        <h4>Localisation :</h4>
        <div class="btn-blue">Le Bourget du Lac (ce n'est pas la bonne donnée)</div>
        </div> *@

            <FormulaireContact />
        </div>
    </div>

    @if (AdminState.IsAdmin)
    {
        <button class="btn btn-info mb-3" @onclick="() => GoToUpdate(contact.Id_Contact)">
            Modifier
        </button>
        <button class="btn btn-danger mb-3" @onclick="() => DeleteContact(contact.Id_Contact)">
            Supprimer
        </button>
    }
}

@code {
    [Parameter]
    public int contactId { get; set; }
    private Contact_USMB? contact;

    // ----------- ALERTES SUPPRESSION -----------
    private string deleteMessage = null;
    private bool deleteSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        contact = await ContactService.GetByIdAsync(contactId);
    }

    private void RetourListeStr(string idEquipement, string nomChemin)
    {
        Navigation.NavigateTo($"/{nomChemin}/{idEquipement}");
    }

    // ----------- SUPPRESSION AVEC CONFIRMATION + MESSAGE -----------
    private async Task DeleteContact(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>(
            "confirm",
            "Voulez-vous vraiment supprimer ce contact ?"
        );

        if (!confirm)
            return;

        try
        {
            await ContactService.DeleteAsync(id);
            deleteSuccess = true;
            await ShowDeleteAlert("Contact supprimé avec succès");
            Navigation.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            deleteSuccess = false;
            await ShowDeleteAlert($"Erreur lors de la suppression : {ex.Message}");
        }
    }

    // ----------- AFFICHAGE & AUTO-DISPARITION -----------
    private async Task ShowDeleteAlert(string msg)
    {
        deleteMessage = msg;
        StateHasChanged();
        await Task.Delay(3000);
        deleteMessage = null;
        StateHasChanged();
    }

    private void GoToUpdate(int id)
    {
        Navigation.NavigateTo($"/contact/edit/{id}", true);
    }
}

