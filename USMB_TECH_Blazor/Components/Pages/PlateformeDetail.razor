@page "/plateforme/{Id:int}"
@inject IMainService<Plateforme,int> PlateformeService
@inject IMainService<Prestation,int> PrestationService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<HeadContent>
    <link href="css/PlateformeEquipementDetail.css" rel="stylesheet" />
</HeadContent>

<PageTitle>Détails Plateforme</PageTitle>

@if (!string.IsNullOrEmpty(deleteMessage))
{
    <div class="alert @(deleteSuccess ? "alert-success" : "alert-danger") alert-fixed">
        @deleteMessage
    </div>
}

@if (plateforme == null)
{
    <p>Loading...</p>
}
else
{
    <div class="container">
        <!-- ========= COLONNE GAUCHE ========= -->
        <div class="col-left">
            <section>
                <h2>@plateforme.Nom_Plateforme</h2>
                <p>@plateforme.Description_Plateforme</p>

                <div class="equipement-item">
                    @foreach (Photo image in plateforme.Photos)
                    {
                        <img src="@image.Url_Photo" alt="photo plateforme" />
                    }
                </div>
            </section>

            <section>
                <h3>MOTS CLÉS</h3>
                <ul class="list-style">
                    @foreach (var mot in motsCles)
                    {
                        <li>@mot.Nom_Mot_Clef</li>
                    }
                </ul>
            </section>

            <section>
                <h3>CATALOGUE DE PRESTATIONS</h3>
                <ul class="list-style">
                    @foreach (var prestation in prestations)
                    {
                        <li>
                            <strong>@prestation.Intitule_Prestation :</strong>
                            <span>@prestation.Description_Prestation</span>
                        </li>
                    }
                </ul>
            </section>
        </div>

        <!-- ========= COLONNE CENTRALE ========= -->
        <div class="col-center">
            <section>
                <h3>NOS ÉQUIPEMENTS</h3>

                <div class="equipement-grid">
                    @foreach (var equipement in plateforme.Equipements)
                    {
                        <div class="equipement-item" @onclick="@(() => RetourListe(equipement.Id_Equipement))">
                            @if (equipement.Photos != null && equipement.Photos.Any())
                            {
                                var photo = equipement.Photos.First();
                                <img src="@photo.Url_Photo" alt="photo équipement" />
                            }
                            <p>@equipement.Nom_Equipement</p>
                        </div>
                    }
                </div>
            </section>

            <section>
                <h3>EXEMPLES DE RÉALISATIONS</h3>
                <p>@plateforme.Description_Contenu</p>
            </section>
        </div>

        <!-- ========= COLONNE DROITE ========= -->
        <div class="col-right">
            <div class="info-block">
                <h4>Domaine d'excellence :</h4>
                <div class="btn-blue">@thematique</div>
            </div>

            <div class="info-block">
                <h4>Localisation :</h4>
                <div class="btn-blue">Le Bourget du Lac (placeholder)</div>
            </div>

            <FormulaireContact />
        </div>

    </div>

    <button class="btn btn-info mb-3" @onclick="() => GoToUpdate(plateforme.Id_Plateforme)">
        Modifier
    </button>
    <button class="btn btn-danger mb-3" @onclick="() => DeletePlateforme(plateforme.Id_Plateforme)">
        Supprimer
    </button>

}

@code {
    [Parameter]
    public int Id { get; set; }

    private Plateforme? plateforme;
    private List<Prestation> prestations = new();
    private List<Mot_Clef> motsCles = new();
    private string thematique;

    // ----------- ALERTES SUPPRESSION -----------
    private string deleteMessage = null;
    private bool deleteSuccess = false;


    protected override async Task OnInitializedAsync()
    {
        plateforme = await PlateformeService.GetByIdAsync(Id);

        prestations = plateforme.Presenters
            .Select(p => p.prestationNavigation)
            .ToList();

        motsCles = plateforme.Specifiers
            .Select(s => s.Mot_ClefNavigation)
            .ToList();

        thematique = plateforme.Exposers
            .Select(t => t.ThematiqueNavigation.Nom_Thematique)
            .FirstOrDefault();
    }


    // ----------- SUPPRESSION AVEC CONFIRMATION + MESSAGE -----------
    private async Task DeletePlateforme(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>(
            "confirm",
            "Voulez-vous vraiment supprimer cette plateforme ?"
        );

        if (!confirm)
            return;

        try
        {
            await PlateformeService.DeleteAsync(id);

            deleteSuccess = true;
            await ShowDeleteAlert("Plateforme supprimée avec succès ✅");
            Navigation.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            deleteSuccess = false;
            await ShowDeleteAlert($"Erreur lors de la suppression ❌ : {ex.Message}");
        }
    }


    // ----------- AFFICHAGE & AUTO-DISPARITION -----------
    private async Task ShowDeleteAlert(string msg)
    {
        deleteMessage = msg;
        StateHasChanged();

        await Task.Delay(3000);

        deleteMessage = null;
        StateHasChanged();
    }


    private void RetourListe(int idEquipement)
    {
        Navigation.NavigateTo($"/equipement/{idEquipement}");
    }

    private void GoToUpdate(int id)
    {
        Navigation.NavigateTo($"/plateforme/edit/{id}", true);
    }
}
