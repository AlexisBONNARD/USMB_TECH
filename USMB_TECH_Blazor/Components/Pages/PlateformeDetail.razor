@page "/plateforme/{Id:int}"
@inject IMainService<Plateforme,int> PlateformeService
@inject IMainService<Prestation,int> PrestationService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<HeadContent>
    <link href="css/PlateformeEquipementDetail.css" rel="stylesheet" />
</HeadContent>

<PageTitle>Détails Plateforme</PageTitle>

@if (plateforme == null)
{
    <p>Loading...</p>
}
else
{
    <div class="container">

        <!-- ========= COLONNE GAUCHE ========= -->
        <div class="col-left">
            <section>
                <h2>@plateforme.Nom_Plateforme</h2>
                <p>@plateforme.Description_Plateforme</p>
                <div class="equipement-item">
                    @foreach (Photo image in plateforme.Photos)
                    {
                        <img src=@image.Url_Photo alt="photo plateforme" />
                    }
                </div>
            </section>

            <section>
                <h3>MOTS CLÉS</h3>
                <ul class="list-style">
                    @foreach (var mot in motsCles)
                    {
                        <li>@mot.Nom_Mot_Clef</li>
                    }
                </ul>
            </section>

            <section>
                <h3>CATALOGUE DE PRESTATIONS</h3>
                <ul class="list-style">
                    @foreach (var prestation in prestations)
                    {
                        <li>
                            <strong>@prestation.Intitule_Prestation :</strong>
                            <span>@prestation.Description_Prestation</span>
                        </li>
                    }
                </ul>
            </section>
        </div>

        <!-- ========= COLONNE CENTRALE ========= -->
        <div class="col-center">
            <section>
                <h3>NOS ÉQUIPEMENTS</h3>

                <div class="equipement-grid">
                    @foreach (Equipement equipement in plateforme.Equipements)
                    {
                        <div class="equipement-item">
                            @if (equipement.Photos?.Any() == false)
                            {
                                Photo photo = equipement.Photos.OrderBy(x => Guid.NewGuid()).First();
                                Console.WriteLine(photo);
                                <img src="@photo.Url_Photo" alt="photo équipement" />
                            }
                            <p>@equipement.Nom_Equipement</p>
                        </div>
                    }
                </div>
            </section>

            <section>
                <h3>EXEMPLES DE RÉALISATIONS</h3>
                <p>@plateforme.Description_Contenu</p>
            </section>
        </div>

        <!-- ========= COLONNE DROITE ========= -->
        <div class="col-right">

            <div class="info-block">
                <h4>Domaine d'excellence :</h4>
                <div class="btn-blue">@thematique</div>
            </div>

            <div class="info-block">
                <h4>Localisation :</h4>
                <div class="btn-blue">Le Bourget du Lac (ce n'est pas la bonne donnée)</div>
            </div>

            <FormulaireContact />

        </div>

    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }
    private Plateforme? plateforme;
    private List<Prestation> prestations = new List<Prestation>();
    private List<Mot_Clef> motsCles = new List<Mot_Clef>();
    private string thematique;


    protected override async Task OnInitializedAsync()
    {
        plateforme = await PlateformeService.GetByIdAsync(Id);
        prestations = plateforme.Presenters.Select(p => p.prestationNavigation).ToList();
        motsCles = plateforme.Specifiers.Select(s => s.Mot_ClefNavigation).ToList();
        thematique = plateforme.Exposers.Select(t => t.ThematiqueNavigation.Nom_Thematique).FirstOrDefault();

    }

    private void RetourListe(int idEquipement)
    {
        Navigation.NavigateTo($"/equipement/{idEquipement}");
    }
}