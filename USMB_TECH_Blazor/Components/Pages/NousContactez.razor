@page "/nous_contactez"
@inject IMainService<Contact_USMB,int> ContactService
@inject NavigationManager Navigation
@inject AdminState AdminState
@inject IJSRuntime JS
@inject IMainService<Pole_Expertise ,int> Pole_ExpertiseService
@inject IMainService<Equipement,int> EquipementService
@inject IMainService<Laboratoire, string> LaboratoireService
@inject IMainService<Prise_Contact,int> Prise_ContactService
@inject IMainService<Type_Client,int> Type_ClientService
@inject IMainService<Type_Utilisation,int> Type_UtilisationService

<HeadContent>
    <link href="css/NousContactez.css" rel="stylesheet" />
</HeadContent>

<PageTitle>Nous Contactez</PageTitle>

<h3>Nous Contactez</h3>

<div class="contact-section">
    <EditForm Model="@prise_contact" OnSubmit="HandleSubmit" key="@prise_contact">
        <DataAnnotationsValidator />
        <div class="form-container">

            <div class="row">
                <InputText class="input half" data-testid="contact-nom" @bind-Value="prise_contact.Nom_Contact" placeholder="Nom *" />
                <InputText class="input half" data-testid="contact-prenom" @bind-Value="prise_contact.Prenom_Contact" placeholder="Prénom *" />
                <InputText class="input half" data-testid="contact-email" @bind-Value="prise_contact.Email_Contact" placeholder="Email *" />
                <ValidationMessage For="@(() => prise_contact.Nom_Contact)" />
                <ValidationMessage For="@(() => prise_contact.Prenom_Contact)" />
                <ValidationMessage For="@(() => prise_contact.Email_Contact)" />
            </div>

            <div class="row">
                <label>Type d’entité :</label>
                <InputSelect class="input" data-testid="contact-entreprise" @bind-Value="prise_contact.Entreprise_Contact">
                    <option value="Aucun">Je ne sais pas</option>
                    @foreach (var tc in type_clients)
                    {
                        <option value="@tc.Nom_Type_Client">@tc.Nom_Type_Client</option>
                    }
                </InputSelect>
            </div>

            <div class="row">
                <label>Type de besoin :</label>
                <InputSelect class="input" @bind-Value="typeBesoinSelectionne">
                    <option value="Aucun">Je ne sais pas</option>
                    @foreach (var tu in type_utilisations)
                    {
                        <option value="@tu.Nom_Type_Utilisation">@tu.Nom_Type_Utilisation</option>
                    }
                </InputSelect>
            </div>
            <InputTextArea class="input textarea"
                           @bind-Value="precisionBesoin"
                           placeholder="Précisez votre besoin *" />

            <button type="submit" class="submit-btn" data-testid="contact-submit">ENVOYER</button>
        </div>
    </EditForm>

    @if (!string.IsNullOrEmpty(message))
    {
        <div id="alertMessage" data-testid="contact-alert"
             class="alert @(isSuccess ? "alert-success" : "alert-danger") alert-fixed"
             style="font-size:@(isMultipleErrors ? "18px" : "14px")"
             @onclick="() => message = null">
            @((MarkupString)message)
        </div>
    }
</div>

@code {
    private TypeBesoin typeBesoinSelectionne = TypeBesoin.Aucun;
    private string? precisionBesoin;
    public enum TypeBesoin
    {
        Aucun,
        Prestation,
        Formation,
        Location
    }
    private string? message;
    private bool isSuccess = false;
    private bool isMultipleErrors = false;
    private TypeCible typeSelectionne = TypeCible.Aucun;
    private Prise_Contact prise_contact = new()
        {
            Id_Type_Client = 1
        };
    private List<Pole_Expertise> pole_expertises = new();
    private List<Equipement> equipements = new();
    private Equipement equipement = new();
    private List<Laboratoire> laboratoires = new();
    private List<Type_Client> type_clients = new();
    private List<Type_Utilisation> type_utilisations = new();

    protected override async Task OnInitializedAsync()
    {
        pole_expertises = (await Pole_ExpertiseService.GetAllAsync())
            .Where(x => x != null).ToList()!;

        equipements = (await EquipementService.GetAllAsync())
            .Where(x => x != null).ToList()!;

        laboratoires = (await LaboratoireService.GetAllAsync())
            .Where(x => x != null).ToList()!;

        AutoFillFromUrl();

        type_clients = (await Type_ClientService.GetAllAsync()).Where(x => x != null).ToList()!;

        if (prise_contact.Id_Equipement != null)
        {
            equipement = await EquipementService.GetByIdAsync(prise_contact.Id_Equipement.Value);

            // type_clients = equipement.Autorisers.Select(a => a.Type_ClientNavigation).Where(tc => tc != null).Distinct().ToList();

            type_utilisations = equipement.Proposers.Select(p => p.Type_UtilisationNavigation).Where(tu => tu != null).Distinct().ToList();
        }
        else
        {
            type_utilisations = (await Type_UtilisationService.GetAllAsync()).Where(x => x != null).ToList()!;
        }
    }

    private void AutoFillFromUrl()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var segments = relative.Split('/', StringSplitOptions.RemoveEmptyEntries);

        for (int i = 0; i < segments.Length; i++)
        {
            if (segments[i].Equals("equipement", StringComparison.OrdinalIgnoreCase)
                && i + 1 < segments.Length
                && int.TryParse(segments[i + 1], out int idEquip))
            {
                typeSelectionne = TypeCible.Equipement;
                prise_contact.Id_Equipement = idEquip;
            }

            if (segments[i].Equals("pole_expertise", StringComparison.OrdinalIgnoreCase)
                && i + 1 < segments.Length
                && int.TryParse(segments[i + 1], out int idPole))
            {
                typeSelectionne = TypeCible.Pole;
                prise_contact.Id_Pole_Expertise = idPole;
            }

            if (segments[i].Equals("laboratoire", StringComparison.OrdinalIgnoreCase)
                && i + 1 < segments.Length)
            {
                typeSelectionne = TypeCible.Laboratoire;
                prise_contact.Nom_Court = segments[i + 1];
            }
        }
    }

    private void NormaliserAvantEnvoi()
    {
        if (typeSelectionne != TypeCible.Equipement)
            prise_contact.Id_Equipement = null;

        if (typeSelectionne != TypeCible.Pole)
            prise_contact.Id_Pole_Expertise = null;

        if (typeSelectionne != TypeCible.Laboratoire)
            prise_contact.Nom_Court = null;
    }

    private bool ValiderCible()
    {
        return
            typeSelectionne == TypeCible.Equipement && prise_contact.Id_Equipement != null
         || typeSelectionne == TypeCible.Pole && prise_contact.Id_Pole_Expertise != null
         || typeSelectionne == TypeCible.Laboratoire && !string.IsNullOrWhiteSpace(prise_contact.Nom_Court);
    }

    private async Task HandleSubmit()
    {
        NormaliserAvantEnvoi();

        if (!ValiderCible())
        {
            await ShowAlert(
                "Veuillez sélectionner soit un équipement, soit un pôle d’expertise, soit un laboratoire.",
                false
            );
            return;
        }

        prise_contact.Description_besoins = ConstruireDescriptionBesoins();

        try
        {
            await Prise_ContactService.AddAsync(prise_contact);
            await ShowAlert("Votre demande a bien été envoyée !", true);

            prise_contact = new() { Id_Type_Client = 1 };
            typeSelectionne = TypeCible.Aucun;
            typeBesoinSelectionne = TypeBesoin.Aucun;
            precisionBesoin = null;
        }
        catch (Exception ex)
        {
            await ShowAlert("Une erreur technique est survenue. Veuillez réessayer.", false);
            await JS.InvokeVoidAsync("console.error", ex.ToString());
        }
    }

    private async Task ShowAlert(string msg, bool success)
    {
        message = msg;
        isSuccess = success;

        StateHasChanged();

        await Task.Delay(5000);

        message = null;
        isMultipleErrors = false;
        StateHasChanged();
    }

    private string ConstruireDescriptionBesoins()
    {
        if (typeBesoinSelectionne == TypeBesoin.Aucun && string.IsNullOrWhiteSpace(precisionBesoin))
            return string.Empty;

        if (typeBesoinSelectionne == TypeBesoin.Aucun)
            return precisionBesoin!.Trim();

        if (string.IsNullOrWhiteSpace(precisionBesoin))
            return typeBesoinSelectionne.ToString();

        return $"{typeBesoinSelectionne} : {precisionBesoin.Trim()}";
    }
}
