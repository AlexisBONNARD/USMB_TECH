@page "/pole_expertise/{Id:int}"
@inject IMainService<Pole_Expertise,int> Pole_ExpertiseService
@inject IMainService<Prestation,int> PrestationService
@inject NavigationManager Navigation
@inject AdminState AdminState
@inject IJSRuntime JS

<HeadContent>
    <link href="css/PageDetail.css" rel="stylesheet" />
</HeadContent>

<PageTitle>Détails Pole_Expertise</PageTitle>

@if (!string.IsNullOrEmpty(deleteMessage))
{
    <div class="alert @(deleteSuccess ? "alert-success" : "alert-danger") alert-fixed">
        @deleteMessage
    </div>
}

@if (pole_expertise == null)
{
    <p>Loading...</p>
}
else
{
    <div class="container">
        <!-- ========= COLONNE GAUCHE ========= -->
        <div class="col-left">
            <section>
                <h2>@pole_expertise.Nom_Pole_Expertise</h2>
                <Carousel Photos="@pole_expertise.Photos" />
                <p>@pole_expertise.Description_Pole_Expertise</p>
            </section>

            <section>
                <h3>MOTS CLÉS</h3>
                <ul class="list-style">
                    @foreach (var mot in motsCles)
                    {
                        <li>@mot.Nom_Mot_Clef</li>
                    }
                </ul>
            </section>
            <h3>EXEMPLES DE RÉALISATIONS</h3>
            <p>@pole_expertise.Description_Contenu</p>
        </div>

        <!-- ========= COLONNE CENTRALE ========= -->
        <div class="col-center">
            <section>
                <h3>NOS ÉQUIPEMENTS</h3>

                <div class="center-grid">
                    @foreach (var equipement in pole_expertise.Equipements)
                    {
                        <div class="center-item" @onclick="@(() => RetourListe(equipement.Id_Equipement))">
                            @if (equipement.Photos != null && equipement.Photos.Any())
                            {
                                var photo = equipement.Photos.First();
                                <img src="@photo.Url_Photo" alt="@photo.Nom_Photo" />
                            }
                            <p>@equipement.Nom_Equipement</p>
                        </div>
                    }
                </div>
            </section>

            <section>
                <h3>NOS PRESTATIONS</h3>
                <div class="center-grid">
                    @foreach (var prestation in prestations)
                    {
                        <div class="center-item" @onclick="@(() => Navigation.NavigateTo($"/prestation/{prestation.Id_Prestation}"))">
                            @if (prestation.Photos != null && prestation.Photos.Any())
                            {
                                var photo = prestation.Photos.First();
                                <img src="@photo.Url_Photo" alt="@photo.Nom_Photo" />
                            }
                            <p>@prestation.Intitule_Prestation</p>
                        </div>
                    }
                </div>
                
            </section>
        </div>

        <!-- ========= COLONNE DROITE ========= -->
        <div class="col-right">
            <div class="info-block">
                <h4>Domaine d'excellence :</h4>
                <div class="btn-blue" @onclick="@(() => GoToDomaine(pole_expertise.Domaine_ExcellenceNavigation.Id_Domaine_Excellence))">
                    @pole_expertise?.Domaine_ExcellenceNavigation?.Intitule_Domaine_Excellence
                </div>
            </div>

          @*   <div class="info-block">
                <h4>Localisation :</h4>
                <div class="btn-blue">Le Bourget du Lac</div>
            </div> *@

            <FormulaireContact />
        </div>

    </div>

    @if (AdminState.IsAdmin)
    {
        <button class="btn btn-info mb-3" @onclick="() => GoToUpdate(pole_expertise.Id_Pole_Expertise)">
            Modifier
        </button>
        <button class="btn btn-danger mb-3" @onclick="() => DeletePole_Expertise(pole_expertise.Id_Pole_Expertise)">
            Supprimer
        </button>
    }

}

@code {
    [Parameter]
    public int Id { get; set; }

    private Pole_Expertise? pole_expertise;
    private List<Prestation> prestations = new();
    private List<Mot_Clef> motsCles = new();
    private string domaine_excellence;

    // ----------- ALERTES SUPPRESSION -----------
    private string deleteMessage = null;
    private bool deleteSuccess = false;


    protected override async Task OnInitializedAsync()
    {
        pole_expertise = await Pole_ExpertiseService.GetByIdAsync(Id);

        prestations = pole_expertise.Presenters
            .Select(p => p.prestationNavigation)
            .ToList();

        motsCles = pole_expertise.Specifiers
            .Select(s => s.Mot_ClefNavigation)
            .ToList();

        domaine_excellence = pole_expertise.Domaine_ExcellenceNavigation?.Intitule_Domaine_Excellence;
    }


    // ----------- SUPPRESSION AVEC CONFIRMATION + MESSAGE -----------
    private async Task DeletePole_Expertise(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>(
            "confirm",
            "Voulez-vous vraiment supprimer ce pole d'expertise ?"
        );

        if (!confirm)
            return;

        try
        {
            await Pole_ExpertiseService.DeleteAsync(id);

            deleteSuccess = true;
            await ShowDeleteAlert("Pole d'expertise supprimé avec succès ✅");
            Navigation.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            deleteSuccess = false;
            await ShowDeleteAlert($"Erreur lors de la suppression ❌ : {ex.Message}");
        }
    }


    // ----------- AFFICHAGE & AUTO-DISPARITION -----------
    private async Task ShowDeleteAlert(string msg)
    {
        deleteMessage = msg;
        StateHasChanged();

        await Task.Delay(3000);

        deleteMessage = null;
        StateHasChanged();
    }


    private void RetourListe(int idEquipement)
    {
        Navigation.NavigateTo($"/equipement/{idEquipement}");
    }

    private void GoToDomaine(int idDomaine)
    {
        Navigation.NavigateTo($"/DomaineExcellence/{idDomaine}");
    }

    private void GoToUpdate(int id)
    {
        Navigation.NavigateTo($"/pole_expertise/edit/{id}", true);
    }


}
