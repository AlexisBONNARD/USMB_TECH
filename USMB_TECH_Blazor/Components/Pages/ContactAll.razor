@page "/contact"
@inject IMainService<Contact_USMB,int> ContactService
@inject NavigationManager Navigation
@inject AdminState AdminState
@inject IJSRuntime JS


<h1>Liste des contacts</h1>

@if (contacts is null)
{
    <p>Chargement...</p>
}
else if (!contacts.Any())
{
    <p>Aucune prise de contact trouvée.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Mail</th>
                <th>Num_Securite_Social</th>
                <th>Détails</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var contact in contacts)
            {
                <tr>
                    <td>@contact.Nom_Contact</td>
                    <td>@contact.Prenom_Contact</td>
                    <td>@contact.Mail</td>
                    <td>@contact.Num_Securite_Social</td>
                    <td>
                        <button class="btn btn-primary" @onclick="@(() => RetourListe(contact.Id_Contact, "contact"))">
                            Voir
                        </button>
                    </td>
                    @if (AdminState.IsAdmin)
                    {
                        <td>
                            <button class="btn btn-info mb-3" @onclick="() => GoToUpdate(contact.Id_Contact)">
                                Modifier
                            </button>
                        </td>
                        <td>
                            <button class="btn btn-danger mb-3" @onclick="() => DeleteEquipement(contact.Id_Contact)">
                                Supprimer
                            </button>
                        </td>
        }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Contact_USMB> contacts = new();

    // ----------- ALERTES SUPPRESSION -----------
    private string deleteMessage = null;
    private bool deleteSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        contacts = (await ContactService.GetAllAsync())
            .Where(x => x != null).ToList()!;
    }

    private void RetourListe(int id, string nomChemin)
    {
        Navigation.NavigateTo($"/{nomChemin}/{id}");
    }

    // ----------- SUPPRESSION AVEC CONFIRMATION + MESSAGE -----------
    private async Task DeleteEquipement(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>(
            "confirm",
            "Voulez-vous vraiment supprimer cet équipement ?"
        );

        if (!confirm)
            return;

        try
        {
            await ContactService.DeleteAsync(id);
            deleteSuccess = true;
            await ShowDeleteAlert("Équipement supprimé avec succès");
            Navigation.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            deleteSuccess = false;
            await ShowDeleteAlert($"Erreur lors de la suppression : {ex.Message}");
        }
    }

    // ----------- AFFICHAGE & AUTO-DISPARITION -----------
    private async Task ShowDeleteAlert(string msg)
    {
        deleteMessage = msg;
        StateHasChanged();
        await Task.Delay(3000);
        deleteMessage = null;
        StateHasChanged();
    }

    private void RetourListe(int idPole_Expertise)
    {
        Navigation.NavigateTo($"/pole_expertise/{idPole_Expertise}");
    }

    private void GoToUpdate(int id)
    {
        Navigation.NavigateTo($"/equipement/edit/{id}", true);
    }
}
