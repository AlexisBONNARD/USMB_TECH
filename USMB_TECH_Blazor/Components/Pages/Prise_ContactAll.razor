@page "/prise_contact"
@inject IMainService<Prise_Contact, int> Prise_ContactService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<h1>Liste des prises de contact</h1>

@if (prise_contacts is null)
{
    <p>Chargement...</p>
}
else if (!prise_contacts.Any())
{
    <p>Aucune prise de contact trouvée.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>Entreprise</th>
                <th>Détails</th>
                <th>Supprimer</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var contact in prise_contacts)
            {
                <tr>
                    <td>@contact.Nom_Contact</td>
                    <td>@contact.Prenom_Contact</td>
                    <td>@contact.Email_Contact</td>
                    <td>@contact.Entreprise_Contact</td>
                    <td>
                        <button class="btn btn-primary" @onclick="@(() => RetourListe(contact.Num_Prise_Contact, "prise_contact"))">
                            Voir
                        </button>
                    </td>
                    <td>
                        <button data-testid="prise_contact-delete-btn" class="btn btn-danger mb-3" @onclick="() => DeletePrise_Contact(contact.Num_Prise_Contact)">
                            Supprimer
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Prise_Contact> prise_contacts = new();

    // ----------- ALERTES SUPPRESSION -----------
    private string deleteMessage = null;
    private bool deleteSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        prise_contacts = (await Prise_ContactService.GetAllAsync())
            .Where(x => x != null).ToList()!;
    }

    private void RetourListe(int id, string nomChemin)
    {
        Navigation.NavigateTo($"/{nomChemin}/{id}");
    }

    // ----------- SUPPRESSION AVEC CONFIRMATION + MESSAGE -----------
    private async Task DeletePrise_Contact(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>(
            "confirm",
            "Voulez-vous vraiment supprimer ce contact ?"
        );

        if (!confirm)
            return;

        try
        {
            await Prise_ContactService.DeleteAsync(id);
            deleteSuccess = true;
            await ShowDeleteAlert("Contact supprimé avec succès");
            Navigation.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            deleteSuccess = false;
            await ShowDeleteAlert($"Erreur lors de la suppression : {ex.Message}");
        }
    }

    // ----------- AFFICHAGE & AUTO-DISPARITION -----------
    private async Task ShowDeleteAlert(string msg)
    {
        deleteMessage = msg;
        StateHasChanged();
        await Task.Delay(3000);
        deleteMessage = null;
        StateHasChanged();
    }
}
