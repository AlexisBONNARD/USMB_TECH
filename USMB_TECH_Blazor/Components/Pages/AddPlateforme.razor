@page "/ajouter-plateforme"
@using USMB_TECH.Models
@inject HttpClient Http
@inject Service.IMainService<Prestation,int> prestationDatas


<HeadContent>
    <li class="add_platform" nk href="css/addPlateforms.css" rel="stylesheet" />
</HeadContent>

<h2 class="add_platform">Ajouter une plateforme</h2>

<div class="page-container">
    <EditForm Model="@plateforme" OnValidSubmit="SubmitPlateforme">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <h4 class="add_platform">Infos générales</h4>
        <label>Nom plateforme *</label>
        <InputText class="form-control mb-2" @bind-Value="plateforme.Nom_Plateforme" />
        <ValidationMessage For="@(() => plateforme.Nom_Plateforme)" />

        <label>Description *</label>
        <InputTextArea class="form-control mb-2" @bind-Value="plateforme.Description_Plateforme" />
        <ValidationMessage For="@(() => plateforme.Description_Plateforme)" />

        <label>Nom contenu *</label>
        <InputText class="form-control mb-2" @bind-Value="plateforme.Nom_Contenu" />
        <ValidationMessage For="@(() => plateforme.Nom_Contenu)" />

        <label>URL contenu *</label>
        <InputText class="form-control mb-2" @bind-Value="plateforme.Url_Contenu" />
        <ValidationMessage For="@(() => plateforme.Url_Contenu)" />

        <label>Description contenu *</label>
        <InputTextArea class="form-control mb-2" @bind-Value="plateforme.Description_Contenu" />
        <ValidationMessage For="@(() => plateforme.Description_Contenu)" />

        <label class="mt-2">Active ?</label>
        <InputSelect class="form-control mb-2" @bind-Value="plateforme.Actif">
            <option value="true">Oui</option>
            <option value="false">Non</option>
        </InputSelect>

        <hr />
        <h4 class="add_platform">Photos</h4>
        <InputFile OnChange="HandleFileUpload" />

        @code {
            private async Task HandleFileUpload(InputFileChangeEventArgs e)
            {
                var file = e.File;

                using var content = new MultipartFormDataContent();
                var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10_000_000));
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

                content.Add(fileContent, "file", file.Name);

                var response = await Http.PostAsync("https://api-usmbtech-hvevdvgbdwh7aqf5.francecentral-01.azurewebsites.net/api/plateformes/upload", content);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<UploadResponse>();
                    plateforme.Photos.Add(new Photo
                    {
                        Nom_Photo = file.Name,
                        Url_Photo = result.url
                    });
                }
            }

            public class UploadResponse
            {
                public string url { get; set; }
            }
        }


        <hr />
        <h4 class="add_platform">Mots-clés</h4>
        <form onsubmit="return false;" class="mb-2">
            <input class="form-control mb-1"
                       @bind="newMot_Clef"
                       @bind:event="oninput"
                       placeholder="Ajouter un mot-clé"
                       @onkeydown="@(e => { if (e.Key == "Enter") { AddMot_Clef(); } })" />
            <button type="button" class="btn btn-secondary btn-sm mt-1" @onclick="AddMot_Clef">Ajouter</button>
        </form>
        <ul class="add_platform">
            @foreach (var mc in plateforme.MotsCles)
            {
                <li class="add_platform">
                    @mc.Nom_Mot_Clef
                    <button type="button" class="btn btn-sm btn-danger ms-2" @onclick="() => RemoveMotCle(mc)">Supprimer</button>
                </li>
            }
        </ul>

        <hr />
        <h4 class="add_platform">Thématiques</h4>
        <form onsubmit="return false;" class="mb-2">
            <input class="form-control mb-1"
                       @bind="newThematique"
                       placeholder="Ajouter une thématique"
                       @bind:event="oninput"
                       @onkeydown="@(e => { if (e.Key == "Enter") { AddThematique(); } })" />
            <button type="button" class="btn btn-secondary btn-sm mt-1" @onclick="AddThematique">Ajouter</button>
        </form>
        <ul class="add_platform">
            @foreach (var t in plateforme.Thematiques)
            {
                <li class="add_platform">
                    @t.Nom_Thematique
                    <button type="button" class="btn btn-sm btn-danger ms-2" @onclick="() => RemoveThematique(t)">Supprimer</button>
                </li>
            }
        </ul>


        <hr />
        <h4 class="add_platform">Exemples d’utilisation</h4>
        <form onsubmit="return false;" class="mb-2">
            <InputText class="form-control mb-1"
                       @bind-Value="newExempleNom"
                       placeholder="Nom exemple"
                       @onkeydown="@(e => { if (e.Key == "Enter") { AddExemple(); } })" />
            <input class="form-control mb-1"
                           @bind="newExempleDesc"
                           @bind:event="oninput"
                           placeholder="Description exemple"
                           @onkeydown="@(e => { if (e.Key == "Enter") { AddExemple(); } })" />
            <button type="button" class="btn btn-secondary btn-sm mt-1" @onclick="AddExemple">Ajouter</button>
        </form>
        <ul class="add_platform">
            @foreach (var e in plateforme.ExempleUtilisations)
            {
                <li class="add_platform">
                    @e.Nom_Utilisation : @e.Description_Utilisation
                    <button type="button" class="btn btn-sm btn-danger ms-2" @onclick="() => RemoveExemple(e)">Supprimer</button>
                </li>
            }
        </ul>


        <hr />
        <h4 class="add_platform">Prestations</h4>
        <form onsubmit="return false;" class="mb-2">
            <InputSelect class="form-select mb-1"
                         @bind-Value="selectedPrestationId"
                         @onkeydown="@(e => { if (e.Key == "Enter") { AddPresenter(); } })">
                <option value="">-- Sélectionner une prestation --</option>
                @foreach (var prestation in prestations)
                {
                    <option value="@prestation.Id_Prestation">@prestation.Intitule_Prestation</option>
                }
            </InputSelect>
            <button type="button" class="btn btn-secondary btn-sm mt-1" @onclick="AddPresenter">Ajouter</button>
        </form>
        <ul class="add_platform">
            @foreach (var pr in plateforme.Presenters)
            {
                <li class="add_platform">
                    Prestation ID : @pr.Id_Prestation
                    <button type="button" class="btn btn-sm btn-danger ms-2" @onclick="() => RemovePresenter(pr)">Supprimer</button>
                </li>
            }
        </ul>


        <hr />
        <button class="btn btn-success mt-3" type="submit">Créer la plateforme</button>
    </EditForm>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div id="alertMessage" class="alert @(isSubmitted ? "alert-success" : "alert-danger") alert-fixed">
        @message
    </div>
}

@code {
    Plateforme plateforme = new Plateforme();
    private List<Prestation> prestations = new();
    
    string newMot_Clef = "";
    string newThematique = "";
    string newExempleNom = "";
    string newExempleDesc = "";
    string newEquipement = "";
    int? selectedPrestationId = null;


    bool isSubmitted = false;
    string message = "";

    protected override async Task OnInitializedAsync()
    {
        prestations = (await prestationDatas.GetAllAsync()).ToList();
    }

    void AddMot_Clef()
    {
        if (!string.IsNullOrWhiteSpace(newMot_Clef))
        {
            plateforme.MotsCles.Add(new Mot_Clef { Nom_Mot_Clef = newMot_Clef });
            newMot_Clef = "";
        }
    }

    void AddThematique()
    {
        if (!string.IsNullOrWhiteSpace(newThematique))
        {
            plateforme.Thematiques.Add(new Thematique { Nom_Thematique = newThematique });
            newThematique = "";
        }
    }

    void AddExemple()
    {
        if (!string.IsNullOrWhiteSpace(newExempleNom) && !string.IsNullOrWhiteSpace(newExempleDesc))
        {
            plateforme.ExempleUtilisations.Add(new USMB_TECH.Models.Exemple_Utilisation
            {
                Nom_Utilisation = newExempleNom,
                Description_Utilisation = newExempleDesc
            });
            newExempleNom = "";
            newExempleDesc = "";
        }
    }

    void AddPresenter()
    {
        if (selectedPrestationId.HasValue)
        {
            plateforme.Presenters.Add(new Presenter
            {
                Id_Prestation = selectedPrestationId.Value
            });
            selectedPrestationId = null;
        }
    }

    async Task SubmitPlateforme()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("https://api-usmbtech-hvevdvgbdwh7aqf5.francecentral-01.azurewebsites.net/api/plateformes", plateforme);

            if (response.IsSuccessStatusCode)
            {
                isSubmitted = true;
                await ShowAlert("Plateforme créée avec succès ✅");
            }
            else
            {
                isSubmitted = false;
                await ShowAlert("Erreur lors de la création ❌");
            }
        }
        catch (Exception ex)
        {
            isSubmitted = false;
            await ShowAlert($"Erreur: {ex.Message}");
        }
    }


    // ----------- AFFICHAGE & AUTO-DISPARITION -----------

    private async Task ShowAlert(string msg)
    {
        message = msg;
        StateHasChanged();

        await Task.Delay(3000); // attend 3 secondes

        message = null;         // efface le message
        StateHasChanged();      // met à jour
    }
    void RemoveMotCle(Mot_Clef mc)
    {
        plateforme.MotsCles.Remove(mc);
    }
    void RemoveThematique(Thematique t)
    {
        plateforme.Thematiques.Remove(t);
    }
    void RemoveExemple(Exemple_Utilisation e)
    {
        plateforme.ExempleUtilisations.Remove(e);
    }
    void RemovePresenter(Presenter pr)
    {
        plateforme.Presenters.Remove(pr);
    }

}

