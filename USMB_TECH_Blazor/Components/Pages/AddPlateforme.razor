@page "/ajouter-pole_expertise"
@using USMB_TECH.Models
@inject NavigationManager Navigation
@inject HttpClient Http
@inject Service.IMainService<Prestation,int> prestationDatas
@inject Service.IMainService<Domaine_Excellence,int> domaineDatas


<HeadContent>
    <li class="add_style" nk href="css/addStyle.css" rel="stylesheet" />
</HeadContent>
@if (isLoading)
{
    <div class="loading-overlay">
        <div class="spinner"></div>
    </div>
}

<h2 class="add_style">Ajouter un pôle d'expertise</h2>

<div class="page-container">
    <EditForm Model="@pole_expertise" OnValidSubmit="SubmitPole_Expertise">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <h4 class="add_style">Infos générales</h4>
        <label>Nom pôle d'expertise *</label>
        <InputText class="form-control mb-2" @bind-Value="pole_expertise.Nom_Pole_Expertise" placeholder="Santé & Sport"/>
        <ValidationMessage For="@(() => pole_expertise.Nom_Pole_Expertise)" />

        <label>Description *</label>
        <InputTextArea class="form-control mb-2" @bind-Value="pole_expertise.Description_Pole_Expertise" placeholder="Pôle d'expertise dédiée à la Santé & au Sport" />
        <ValidationMessage For="@(() => pole_expertise.Description_Pole_Expertise)" />

        <label>Nom contenu *</label>
        <InputText class="form-control mb-2" @bind-Value="pole_expertise.Nom_Contenu" placeholder="Présentation laboratoire" />
        <ValidationMessage For="@(() => pole_expertise.Nom_Contenu)" />

        <label>URL contenu *</label>
        <InputText class="form-control mb-2" @bind-Value="pole_expertise.Url_Contenu" placeholder="https://www.univ-smb.fr"/>
        <ValidationMessage For="@(() => pole_expertise.Url_Contenu)" />

        <label>Description contenu *</label>
        <InputTextArea class="form-control mb-2" @bind-Value="pole_expertise.Description_Contenu" placeholder="Présentation de ce laboratoire" />
        <ValidationMessage For="@(() => pole_expertise.Description_Contenu)" />

        <label class="mt-2">Active ?</label>
        <InputSelect class="form-control mb-2" @bind-Value="pole_expertise.Actif">
            <option value="true">Oui</option>
            <option value="false">Non</option>
        </InputSelect>

        <hr />
        <h4 class="add_style">Photos</h4>
        <InputFile OnChange="HandleFileUpload" />

        @code {
            private async Task HandleFileUpload(InputFileChangeEventArgs e)
            {
                var file = e.File;

                using var content = new MultipartFormDataContent();
                var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10_000_000));
                fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

                content.Add(fileContent, "file", file.Name);

                var response = await Http.PostAsync("https://localhost:7093/api/pole_expertises/upload", content);

                if (response.IsSuccessStatusCode)
                {
                    var result = await response.Content.ReadFromJsonAsync<UploadResponse>();
                    pole_expertise.Photos.Add(new Photo
                    {
                        Nom_Photo = file.Name,
                        Url_Photo = result.url
                    });
                }
            }

            public class UploadResponse
            {
                public string url { get; set; }
            }
        }


        <hr />
        <h4 class="add_style">Mots-clés</h4>
        <form onsubmit="return false;" class="mb-2">
            <input class="form-control mb-1"
                       @bind="newMot_Clef"
                       @bind:event="oninput"
                       placeholder="Ajouter un mot-clé"
                       @onkeydown="@(e => { if (e.Key == "Enter") { AddMot_Clef(); } })" />
            <button type="button" class="btn btn-secondary btn-sm mt-1" @onclick="AddMot_Clef">Ajouter</button>
        </form>
        <ul class="add_style">
            @foreach (var mc in pole_expertise.MotsCles)
            {
                <li class="add_style">
                    @mc.Nom_Mot_Clef
                    <button type="button" class="btn btn-sm btn-danger ms-2" @onclick="() => RemoveMotCle(mc)">Supprimer</button>
                </li>
            }
        </ul>

        <hr />
        <h4 class="add_style">Exemples d’utilisation</h4>
        <form onsubmit="return false;" class="mb-2">
            <InputText class="form-control mb-1"
                       @bind-Value="newExempleNom"
                       placeholder="Nom exemple"
                       @onkeydown="@(e => { if (e.Key == "Enter") { AddExemple(); } })" />
            <input class="form-control mb-1"
                           @bind="newExempleDesc"
                           @bind:event="oninput"
                           placeholder="Description exemple"
                           @onkeydown="@(e => { if (e.Key == "Enter") { AddExemple(); } })" />
            <button type="button" class="btn btn-secondary btn-sm mt-1" @onclick="AddExemple">Ajouter</button>
        </form>
        <ul class="add_style">
            @foreach (var e in pole_expertise.ExempleUtilisations)
            {
                <li class="add_style">
                    @e.Nom_Utilisation : @e.Description_Utilisation
                    <button type="button" class="btn btn-sm btn-danger ms-2" @onclick="() => RemoveExemple(e)">Supprimer</button>
                </li>
            }
        </ul>


        <hr />
        <h4 class="add_style">Prestations</h4>
        <form onsubmit="return false;" class="mb-2">
            <InputSelect class="form-select mb-1"
                         @bind-Value="selectedPrestationId"
                         @onkeydown="@(e => { if (e.Key == "Enter") { AddPresenter(); } })">
                <option value="">-- Sélectionner une prestation --</option>
                @foreach (var prestation in prestations)
                {
                    <option value="@prestation.Id_Prestation">@prestation.Intitule_Prestation</option>
                }
            </InputSelect>
            <button type="button" class="btn btn-secondary btn-sm mt-1" @onclick="AddPresenter">Ajouter</button>
        </form>
        <ul class="add_style">
            @foreach (var pr in pole_expertise.Presenters)
            {
                <li class="add_style">
                    Prestation ID : @pr.Id_Prestation
                    <button type="button" class="btn btn-sm btn-danger ms-2" @onclick="() => RemovePresenter(pr)">Supprimer</button>
                </li>
            }
        </ul>

        <label>Domaine d'excellence *</label>
        <InputSelect class="form-control mb-2"
                     @bind-Value="pole_expertise.Id_Domaine_Excellence">
            <option value="">-- Sélectionner un domaine --</option>
            @foreach (var d in domaines)
            {
                <option value="@d.Id_Domaine_Excellence">@d.Intitule_Domaine_Excellence</option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => pole_expertise.Id_Domaine_Excellence)" />


        <hr />
        <button class="btn btn-success mt-3" type="submit">Créer le pôle d'expertise</button>
    </EditForm>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div id="alertMessage" class="alert @(isSubmitted ? "alert-success" : "alert-danger") alert-fixed">
        @message
    </div>
}

@code {
    Pole_Expertise pole_expertise = new Pole_Expertise();
    private List<Prestation> prestations = new();
    private List<Domaine_Excellence> domaines = new();
    private bool isLoading = false;

    string newMot_Clef = "";
    string newExempleNom = "";
    string newExempleDesc = "";
    string newEquipement = "";
    int? selectedPrestationId = null;
    [Parameter] public EventCallback<Pole_Expertise> OnPole_ExpertiseAdded { get; set; }
    [Parameter] public bool EnableRedirect { get; set; } = true;


    bool isSubmitted = false;
    string message = "";

    protected override async Task OnInitializedAsync()
    {
        prestations = (await prestationDatas.GetAllAsync()).ToList();
        domaines = (await domaineDatas.GetAllAsync()).ToList();
    }

    void AddMot_Clef()
    {
        if (!string.IsNullOrWhiteSpace(newMot_Clef))
        {
            pole_expertise.MotsCles.Add(new Mot_Clef { Nom_Mot_Clef = newMot_Clef });
            newMot_Clef = "";
        }
    }
    void AddExemple()
    {
        if (!string.IsNullOrWhiteSpace(newExempleNom) && !string.IsNullOrWhiteSpace(newExempleDesc))
        {
            pole_expertise.ExempleUtilisations.Add(new USMB_TECH.Models.Exemple_Utilisation
            {
                Nom_Utilisation = newExempleNom,
                Description_Utilisation = newExempleDesc
            });
            newExempleNom = "";
            newExempleDesc = "";
        }
    }

    void AddPresenter()
    {
        if (selectedPrestationId.HasValue)
        {
            pole_expertise.Presenters.Add(new Presenter
            {
                Id_Prestation = selectedPrestationId.Value
            });
            selectedPrestationId = null;
        }
    }

    async Task SubmitPole_Expertise()
    {
        try
        {
            isLoading = true; // active le loader
            StateHasChanged();

            // Si aucune photo uploadée → photo par défaut
            if (pole_expertise.Photos == null || !pole_expertise.Photos.Any())
            {
                pole_expertise.Photos = new List<Photo>
                {
                    new Photo
                    {
                        Nom_Photo = "default-image.png",
                        Url_Photo = "/images/No_image_available.png"
                    }
                };
            }

            var response = await Http.PostAsJsonAsync("https://localhost:7093/api/Pole_Expertises", pole_expertise);
            var createdpole= await response.Content.ReadFromJsonAsync<Pole_Expertise>();

            pole_expertise = createdpole;
            if (response.IsSuccessStatusCode)
            {
                isSubmitted = true;
                await ShowAlert("Pole_Expertise créée avec succès ✅");
            }
            else
            {
                isSubmitted = false;
                await ShowAlert("Erreur lors de la création ❌");
            }
        }
        catch (Exception ex)
        {
            isSubmitted = false;
            await ShowAlert($"Erreur: {ex.Message}");
        }
        finally
        {
            isLoading = false; // désactive le loader
            StateHasChanged();
        }
    }



    // ----------- AFFICHAGE & AUTO-DISPARITION -----------

    private async Task ShowAlert(string msg)
    {
        message = msg;
        StateHasChanged();

        await Task.Delay(3000); // attend 3 secondes

        message = null;         // efface le message
        StateHasChanged();      // met à jour
        if (isSubmitted && EnableRedirect)
        {
            Navigation.NavigateTo($"/pole_expertise/{pole_expertise.Id_Pole_Expertise}");
        }
    }
    void RemoveMotCle(Mot_Clef mc)
    {
        pole_expertise.MotsCles.Remove(mc);
    }
    void RemoveExemple(Exemple_Utilisation e)
    {
        pole_expertise.ExempleUtilisations.Remove(e);
    }
    void RemovePresenter(Presenter pr)
    {
        pole_expertise.Presenters.Remove(pr);
    }

}

