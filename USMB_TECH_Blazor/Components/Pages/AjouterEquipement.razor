@page "/ajouterEquipement"
@inject Service.IMainService<Pole_Expertise,int> pole_expertiseDatas
@inject Service.IMainService<Type_Equipement,int> typeEquipementDatas
@inject Service.IMainService<Equipement,int> equipementDatas
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS

<HeadContent>
    <link rel="stylesheet" href="css/addEquipement.css">
</HeadContent>
<h3>Ajouter un équipement</h3>

<EditForm Model="addEquipement" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="form-group">
        <label>Nom de l'équipement :</label>
        <InputText @bind-Value="addEquipement.Nom_Equipement" />
        <ValidationMessage For="@(() => addEquipement.Nom_Equipement)" />
    </div>

    <div class="form-group">
        <label>Num_Immobilisation :</label>
        <InputText @bind-Value="addEquipement.Num_Immobilisation" />
        <ValidationMessage For="@(() => addEquipement.Num_Immobilisation)" />
    </div>

    <div class="form-group">
        <label>Description Technique :</label>
        <InputText @bind-Value="addEquipement.Description_Technique" />
        <ValidationMessage For="@(() => addEquipement.Description_Technique)" />
    </div>

    <div class="form-group">
        <label>Prix Achat :</label>
        <InputNumber @bind-Value="addEquipement.Prix_Achat" />
        <ValidationMessage For="@(() => addEquipement.Prix_Achat)" />
    </div>

    <div class="form-group">
        <label>Prix Revient :</label>
        <InputNumber @bind-Value="addEquipement.Prix_Revient" />
        <ValidationMessage For="@(() => addEquipement.Prix_Revient)" />
    </div>

    <div class="form-group">
        <label>Modèle :</label>
        <InputText @bind-Value="addEquipement.Nom_Modele" />
        <ValidationMessage For="@(() => addEquipement.Nom_Modele)" />
    </div>

    <div class="form-group">
        <label>Marque :</label>
        <InputText @bind-Value="addEquipement.Nom_Marque" />
        <ValidationMessage For="@(() => addEquipement.Nom_Marque)" />
    </div>

    <div class="form-group">
        <label>Pôle d'expertise associée :</label>
        <InputSelect @bind-Value="addEquipement.Nom_Pole_Expertise" id="pole_expertise">
            <option>...</option>
            @foreach (var pole_expertise in pole_expertises)
            {
                <option value="@pole_expertise.Nom_Pole_Expertise">@pole_expertise.Nom_Pole_Expertise</option>
            }
            <option value="ajouter">Ajouter un pôle d'expertise</option>

        </InputSelect>
        <ValidationMessage For="@(() => addEquipement.Nom_Pole_Expertise)" />
    </div>
    <!-- Modal pour ajouter un pôle d'expertise -->
    <div id="modalPole_Expertise" class="modal" style="display: none;">
        <div class="modal-content">
            <span id="closeModal" class="close">&times;</span>
            <h3>Ajouter un pôle d'expertise</h3>

            <!-- Composant AddPole_Expertise intégré dans la modale -->
            <AddPole_Expertise/>
        </div>
    </div>

    <div class="form-group">
        <label>Type Equipement :</label>
        <InputSelect @bind-Value="addEquipement.Type_Equipement">
            <option>...</option>
            @foreach (var type in type_Equipements)
            {
                <option value="@type.Nom_Type">@type.Nom_Type</option>
            }
        </InputSelect>
        <ValidationMessage For="@(() => addEquipement.Type_Equipement)" />
    </div>

    <div>
        <h4 class="add_platform">Exemple d'utilisation</h4>
        <div>
            <label>Nom de l'exemple : </label>
            <InputText @bind-Value="addEquipement.Nom_Exemple" />
        </div>
        <div>
            <label>Description : </label>
            <InputText @bind-Value="addEquipement.Description_Exemple" />
        </div>
    </div>

    <h4 class="add_platform">Photos</h4>
    <InputFile OnChange="HandleFileUpload" />

    <div class="checkbox-group">
        <InputCheckbox @bind-Value="addEquipement.Autonomie" />
        <label>Autonomie</label>
    </div>

    <div class="checkbox-group">
        <InputCheckbox @bind-Value="addEquipement.Utilisable_Chez_Le_Client" />
        <label>Utilisable chez le client</label>
    </div>

    <button type="submit" class="btn btn-primary">Ajouter</button>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(isSubmitted ? "alert-success" : "alert-danger") mt-3">
            @message
        </div>
    }

</EditForm>


    @code {
    private Equipement addEquipement = new();
    private List<Pole_Expertise> pole_expertises = new();
    private List<Type_Equipement> type_Equipements = new();
    private Marque marqueequipement = new();

    bool isSubmitted = false;
    string message = "";

    protected override async Task OnInitializedAsync()
    {
        pole_expertises = (await pole_expertiseDatas.GetAllAsync()).ToList();
        type_Equipements = (await typeEquipementDatas.GetAllAsync()).ToList();
    }

    private void OnPole_ExpertiseChange(ChangeEventArgs e)
    {
        if (e.Value.ToString() == "ajouter")
        {
            OpenModal(); // Ouvrir la modale pour ajouter un pôle d'expertise
        }
    }

    private void OpenModal()
    {
        // Utiliser JavaScript Interop pour afficher la modale
        JS.InvokeVoidAsync("document.getElementById('modalPole_Expertise').style.display", "block");
    }

    private void CloseModal()
    {
        // Fermer la modale via JavaScript Interop
        JS.InvokeVoidAsync("document.getElementById('modalPole_Expertise').style.display", "none");
    }

    // Callback qui sera appelé lorsque la pole_expertise est ajoutée
    private void OnPole_ExpertiseAdded(Pole_Expertise pole_expertise)
    {
        pole_expertises.Add(pole_expertise);  // Ajouter la nouvelle pole_expertise à la liste
        addEquipement.Nom_Pole_Expertise = pole_expertise.Nom_Pole_Expertise; // Mettre à jour le champ de l'équipement
        CloseModal(); // Fermer la modale après l'ajout
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;

        using var content = new MultipartFormDataContent();
        var fileContent = new StreamContent(file.OpenReadStream(maxAllowedSize: 10_000_000));
        fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);

        content.Add(fileContent, "file", file.Name);

        var response = await Http.PostAsync("https://localhost:7093/api/equipements/upload", content);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<UploadResponse>();
            addEquipement.Photos.Add(new Photo
                {
                    Nom_Photo = file.Name,
                    Url_Photo = result.url
                });
        }
    }
    public class UploadResponse
    {
        public string url { get; set; }
    }
   
    private async Task HandleValidSubmit()
    {
        try
        {
            addEquipement.Date_Acquisition = DateTime.Now;
            addEquipement.Actif = true;
            
            await equipementDatas.AddAsync(addEquipement);

            isSubmitted = true;
            message = "Équipement ajouté avec succès !";
        }
        catch (Exception ex)
        {
            isSubmitted = false;
            // message = ex.Message;
            message = "Il y a eu une erreur lors de l'ajout de l'équipement.";

            await JS.InvokeVoidAsync("console.error", ex.ToString());
        }

    }
    private void PLateformeRotation(string SelectedPole_Expertise)
    {
        addEquipement.Nom_Pole_Expertise = SelectedPole_Expertise;
    }
    private void TypeRotation(string SelectedType)
    {
        addEquipement.Type_Equipement = SelectedType;
    }

}
