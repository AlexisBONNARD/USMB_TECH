@page "/prestation/{Id:int}"
@inject IMainService<Prestation,int> PrestationService
@inject IMainService<Plateforme,int> PlateformeService
@inject IMainService<Equipement,int> EquipementService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<HeadContent>
    <link href="css/PlateformeEquipementDetail.css" rel="stylesheet" />
</HeadContent>

<PageTitle>Détails Plateforme</PageTitle>

@if (prestation == null)
{
    <p>Loading...</p>
}
else
{
    <div class="container">
        <!-- ========= COLONNE GAUCHE ========= -->
        <div class="col-left">
            <section>
                <h2>@prestation.Nom_Court</h2>
                <p>@prestation.Description_Prestation</p>
            </section>

            <section>
                <h3>MOTS CLÉS</h3>
                <ul class="list-style">
                    @* @foreach (var mot in motsCles)
                    {
                        <li>@mot.Nom_Mot_Clef</li>
                    } *@
                </ul>
            </section>

            <section>
                <h3>CATALOGUE DE PRESTATIONS</h3>
                <ul class="list-style">
                    @* @foreach (var prestation in prestations)
                    {
                        <li>
                            <strong>@prestation.Intitule_Prestation :</strong>
                            <span>@prestation.Description_Prestation</span>
                        </li>
                    } *@
                </ul>
            </section>
        </div>

        <!-- ========= COLONNE CENTRALE ========= -->
        <div class="col-center">
            <section>
                <h3>NOS PLATEFORMES</h3>

                <div class="equipement-grid">
                    @foreach (var plateforme in plateformes)
                    {
                        <div class="equipement-item" @onclick="@(() => RetourListe(plateforme.Id_Plateforme))">
                            @if (plateforme.Photos != null && plateforme.Photos.Any())
                            {
                                var photo = plateforme.Photos.First();
                                <img src="@photo.Url_Photo" alt="photo plateforme" />
                            }
                            <p>@plateforme.Nom_Plateforme</p>
                        </div>
                    }

                </div>
            </section>
            <section>
                <h3>NOS ÉQUIPEMENTS</h3>

                <div class="equipement-grid">
                    @foreach (var equipement in equipements)
                    {
                        <div class="equipement-item" @onclick="@(() => RetourListe(equipement.Id_Equipement))">
                            @if (equipement.Photos != null && equipement.Photos.Any())
                            {
                                var photo = equipement.Photos.First();
                                <img src="@photo.Url_Photo" alt="photo équipement" />
                            }
                            <p>@equipement.Nom_Equipement</p>
                        </div>
                    }

                </div>
            </section>
        </div>

        <!-- ========= COLONNE DROITE ========= -->
        <div class="col-right">

            @* <div class="info-block">
                <h4>Domaine d'excellence :</h4>
                <div class="btn-blue">@thematique</div>
            </div> *@

            <div class="info-block">
                <h4>Localisation :</h4>
                <div class="btn-blue">Le Bourget du Lac (ce n'est pas la bonne donnée)</div>
            </div>

            <FormulaireContact />
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }
    private Prestation? prestation;
    private List<Plateforme> plateformes = new List<Plateforme>();
    private List<Equipement> equipements = new List<Equipement>();
    // private List<Mot_Clef> motsCles = new List<Mot_Clef>();
    // private string thematique;


    protected override async Task OnInitializedAsync()
    {
        prestation = await PrestationService.GetByIdAsync(Id);
        foreach (var plateforme in prestation.Presenters)
        {
            var plat = await PlateformeService.GetByIdAsync(plateforme.Id_Plateforme);
            this.plateformes.Add(plat);
        }
        foreach (var equipement in prestation.Fournirs)
        {
            var equip = await EquipementService.GetByIdAsync(equipement.Id_Equipement);
            this.equipements.Add(equip);
        }
        // motsCles = plateforme.Specifiers.Select(s => s.Mot_ClefNavigation).ToList();
        // thematique = plateforme.Exposers.Select(t => t.ThematiqueNavigation.Nom_Thematique).FirstOrDefault();
    }

    private void RetourListe(int idEquipement)
    {
        Navigation.NavigateTo($"/equipement/{idEquipement}");
    }
}
