@page "/prestation/{Id:int}"
@inject IMainService<Prestation,int> PrestationService
@inject IMainService<Pole_Expertise,int> Pole_ExpertiseService
@inject IMainService<Equipement,int> EquipementService
@inject NavigationManager Navigation
@inject AdminState AdminState
@inject IJSRuntime JS

<HeadContent>
    <link href="css/PageDetail.css" rel="stylesheet" />
</HeadContent>

@if (!string.IsNullOrEmpty(deleteMessage))
{
    <div class="alert @(deleteSuccess ? "alert-success" : "alert-danger") alert-fixed">
        @deleteMessage
    </div>
}
@if (prestation == null)
{
    <p>Loading...</p>
}
else
{
    <div class="container">
        <!-- ========= COLONNE GAUCHE ========= -->
        <div class="col-left">
            <section>
                <h2>Prestation : @prestation.Intitule_Prestation</h2>
                <Carousel Photos="@prestation.Photos" />
                <p>@prestation.Description_Prestation</p>
                <p>Laboratoire : @prestation.Nom_Court</p>
            </section>

            <section>
                <h3>PRIX</h3>
                <ul class="list-style">
                    <p>Revient : @prestation.Prix_Revient €</p>
                    <p>Vente : @prestation.Prix_Vente €</p>
                </ul>
            </section>
        </div>

        <!-- ========= COLONNE CENTRALE ========= -->
        <div class="col-center">
            <section>
                <h3>NOS POLES D'EXPERTISE</h3>

                <div class="center-grid">
                    @foreach (var pole_expertise in pole_expertises)
                    {
                        <div class="center-item" @onclick="@(() => RetourListe(pole_expertise.Id_Pole_Expertise, "pole_expertise"))">
                            @if (pole_expertise.Photos != null && pole_expertise.Photos.Any())
                            {
                                var photo = pole_expertise.Photos.First();
                                <img src="@photo.Url_Photo" alt="photo pole_expertise" />
                            }
                            <p>@pole_expertise.Nom_Pole_Expertise</p>
                        </div>
                    }
                </div>
            </section>
            <section>
                <h3>NOS ÉQUIPEMENTS</h3>

                <div class="center-grid">
                    @foreach (var equipement in equipements)
                    {
                        <div class="center-item" @onclick="@(() => RetourListe(equipement.Id_Equipement, "equipement"))">
                            @if (equipement.Photos != null && equipement.Photos.Any())
                            {
                                var photo = equipement.Photos.First();
                                <img src="@photo.Url_Photo" alt="photo équipement" />
                            }
                            <p>@equipement.Nom_Equipement</p>
                        </div>
                    }

                </div>
            </section>
        </div>

        <!-- ========= COLONNE DROITE ========= -->
        <div class="col-right">

            @* <div class="info-block">
                <h4>Localisation :</h4>
                <div class="btn-blue">Le Bourget du Lac (ce n'est pas la bonne donnée)</div>
            </div> *@

            <FormulaireContact />
        </div>
    </div>
    @if (AdminState.IsAdmin)
    {
        <button class="btn btn-info mb-3" @onclick="() => GoToUpdate(prestation.Id_Domaine_Excellence)">
            Modifier
        </button>
        <button class="btn btn-danger mb-3" @onclick="() => DeletePrestation(prestation.Id_Domaine_Excellence)">
            Supprimer
        </button>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }
    private Prestation? prestation;
    private List<Pole_Expertise> pole_expertises = new List<Pole_Expertise>();
    private List<Equipement> equipements = new List<Equipement>();

    private string deleteMessage = null;
    private bool deleteSuccess = false;
    protected override async Task OnInitializedAsync()
    {
        prestation = await PrestationService.GetByIdAsync(Id);
        foreach (var pole_expertise in prestation.Presenters)
        {
            var plat = await Pole_ExpertiseService.GetByIdAsync(pole_expertise.Id_Pole_Expertise);
            this.pole_expertises.Add(plat);
        }
        foreach (var equipement in prestation.Fournirs)
        {
            var equip = await EquipementService.GetByIdAsync(equipement.Id_Equipement);
            this.equipements.Add(equip);
        }
    }

    private void RetourListe(int idEquipement, string nomChemin)
    {
        Navigation.NavigateTo($"/{nomChemin}/{idEquipement}");
    }
    private async Task DeletePrestation(int id)
    {
        bool confirm = await JS.InvokeAsync<bool>(
            "confirm",
            "Voulez-vous vraiment supprimer cette prestation ?"
        );

        if (!confirm)
            return;

        try
        {
            await PrestationService.DeleteAsync(id);

            deleteSuccess = true;
            await ShowDeleteAlert("Prestation supprimée avec succès ✅");
            Navigation.NavigateTo("/", true);
        }
        catch (Exception ex)
        {
            deleteSuccess = false;
            await ShowDeleteAlert($"Erreur lors de la suppression ❌ : {ex.Message}");
        }
    }
    private async Task ShowDeleteAlert(string msg)
    {
        deleteMessage = msg;
        StateHasChanged();

        await Task.Delay(3000);

        deleteMessage = null;
        StateHasChanged();
    }

    private void GoToUpdate(int id)
    {
        Navigation.NavigateTo($"/prestation/edit/{id}", true);
    }

}
