@page "/laboratoire/edit/{Id}"
@inject NavigationManager NavigationManager
@inject IMainService<LaboratoireUpdate, string> laboratoireService
@inject IJSRuntime JS

<h3>LaboratoireEdit</h3>

@if(laboratoire is null)
{
    <p>Loading...</p>
}
else
{
    <div class="page-container">
        <EditForm Model="laboratoire" OnValidSubmit="SubmitLaboratoire">
            @* <DataAnnotationsValidator /> *@
            @* <ValidationSummary /> *@

            <label>Nom complet du laboratoire *</label>
            <InputText class="form-control mb-2" @bind-Value="laboratoire.Nom_Long" placeholder="Nom complet du laboratoire" />
            <ValidationMessage For="@(() => laboratoire.Nom_Long)" />

            <label>Nom du laboratoire *</label>
            <InputText class="form-control mb-2" @bind-Value="laboratoire.Nom_Court" placeholder="Nom court du laboratoire" />
            <ValidationMessage For="@(() => laboratoire.Nom_Court)" />

            <label>Description *</label>
            <InputText class="form-control mb-2" @bind-Value="laboratoire.Description" placeholder="Description du laboratoire" />


            <h4 class="add_style">Adresses</h4>
            <h3 class="add_style">Adresses du laboratoire</h3>

            <label>Rue du laboratoire *</label>
            <InputText class="form-control mb-2" @bind-Value="adresseLabo.Rue_Adresse" placeholder="Numéro et nom de rue de l'adresse du laboratoire" />
            @* <ValidationMessage For="@(() => laboratoire.Rue_Adresse_Labo)" /> *@

            <label>Ville du laboratoire *</label>
            <InputText class="form-control mb-2" @bind-Value="adresseLabo.Ville_Adresse" placeholder="Ville du laboratoire" />
            @* <ValidationMessage For="@(() => laboratoire.Ville_Adresse_Labo)" /> *@

            <label>Code postal du laboratoire *</label>
            <InputText class="form-control mb-2" maxlength="11" @bind-Value="adresseLabo.Code_Postal_Adresse" placeholder="Code postal du laboratoire" />
            @* <ValidationMessage For="@(() => laboratoire.Code_Postal_Adresse_Labo)" /> *@

            <label>Pays du laboratoire *</label>
            <InputSelect class="form-control mb-2" @bind-Value="adresseLabo.Pays_Adresse" placeholder="Pays du laboratoire">
                @foreach (var country in countries)
                {
                    <option value="@country">@country</option>
                }
            </InputSelect>
            @* <ValidationMessage For="@(() => laboratoire.Pays_Adresse_Labo)" /> *@

            <hr />
            <h4 class="add_style">Adresse du campus</h4>

            <label>Rue du campus *</label>
            <InputText class="form-control mb-2" @bind-Value="adresseCampus.Rue_Adresse" placeholder="9 Rue de l'Arc-en-ciel" />
            @* <ValidationMessage For="@(() => laboratoire.Rue_Adresse_Campus)" /> *@

            <label>Ville du campus *</label>
            <InputText class="form-control mb-2" @bind-Value="adresseCampus.Ville_Adresse" placeholder="Annecy-le-vieux" />
            @* <ValidationMessage For="@(() => laboratoire.Ville_Adresse_Campus)" /> *@

            <label>Code postal du campus *</label>
            <InputText class="form-control mb-2" maxlength="11" @bind-Value="adresseCampus.Code_Postal_Adresse" placeholder="74940" />
            @* <ValidationMessage For="@(() => laboratoire.Code_Postal_Adresse_Campus)" /> *@

            <label>Pays du campus *</label>
            <InputSelect class="form-control mb-2" @bind-Value="adresseCampus.Pays_Adresse" placeholder="France">
                @foreach (var country in countries)
                {
                    <option value="@country">@country</option>
                }
            </InputSelect>
            @* <ValidationMessage For="@(() => laboratoire.Pays_Adresse_Campus)" /> *@
                <button typeof="submit">Mettre à jour</button>
        </EditForm>
    </div>
    @if (!string.IsNullOrEmpty(message))
    {
        <div id="alertMessage" class="alert @(isSubmitted ? "alert-success" : "alert-danger") alert-fixed">
            @message
        </div>
    }
}

@code {
    [Parameter]
    public string Id { get; set; }
    private LaboratoireUpdate laboratoire = new LaboratoireUpdate();
    Adresse adresseCampus = new Adresse();
    Adresse adresseLabo = new Adresse();
    private List<string> countries = new List<string>();
    private string message ="";
    bool isSubmitted = false;


    protected override async Task OnInitializedAsync()
    {
        laboratoire = await laboratoireService.GetByIdAsync(Id);
        var client = new HttpClient();
        var json = await client.GetStringAsync("https://data.enseignementsup-recherche.gouv.fr/api/records/1.0/search/?dataset=curiexplore-pays&rows=300");
        var root = JsonNode.Parse(json);
        countries = root["records"].AsArray().Select(r => (string)r["fields"]["name_fr"]).OrderBy(name => name).ToList();
        adresseCampus = laboratoire.Adresse_campusNavigation;
        adresseLabo = laboratoire.Adresse_laboNavigation;
    }
    async Task SubmitLaboratoire()
    {
        try
        {
            laboratoire.Adresse_campusNavigation = adresseCampus;
            laboratoire.Adresse_laboNavigation = adresseLabo;
            laboratoireService.UpdateAsync(laboratoire);
            isSubmitted = true;
            message = "Mise à jour réussi.";
        }
        catch (Exception ex)
        {
            message = ex.Message;
            await JS.InvokeVoidAsync("alert", $"Erreur lors de la mise à jour : {ex.Message}");
        }
    }
}
