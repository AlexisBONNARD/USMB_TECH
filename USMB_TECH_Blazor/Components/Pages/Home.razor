@page "/"
@inject NavigationManager Nav

<div class="hero-section">
    <p class="hero-text">
        <em id="text-home">Accédez à des équipements technologiques et expertises d’excellence</em>
    </p>

    <nav id="search-box-nav">
        <div class="search-box">
            <input @bind="SearchText"
                   @bind:event="oninput"
                   type="text"
                   placeholder="Recherche par mots clés"
                   @onkeydown="HandleKeyDown" />

            <button @onclick="PerformSearch">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </nav>
</div>
@code {
    private string SearchText = "";


    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            PerformSearch();
        }
    }

    private void PerformSearch()
    {
        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var encodedQuery = Uri.EscapeDataString(SearchText);
            Nav.NavigateTo($"/search/motclef/{encodedQuery}");
        }
    }
}