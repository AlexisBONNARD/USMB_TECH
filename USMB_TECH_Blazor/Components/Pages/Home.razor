@page "/"
@inject IMainService<Domaine_Excellence,int> Domaine_ExcellenceService
@inject NavigationManager Nav
@inject IJSRuntime JS

<HeadContent>
    <link href="css/Home.css" rel="stylesheet" />
</HeadContent>

<PageTitle>Home</PageTitle>

<div class="hero-section">
    <p class="hero-text">
        <em id="text-home">Accédez à des équipements technologiques et expertises d’excellence</em>
    </p>

    <nav id="search-box-nav">
        <div class="search-box">
            <input @bind="SearchText"
                   @bind:event="oninput"
                   type="text"
                   placeholder="Recherche par mots clés"
                   @onkeydown="HandleKeyDown" />

            <button @onclick="PerformSearch">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </nav>
</div>


<div class="main-wrapper">
    <div class="main-content">

        <div class="presentations-section">
            <h3>PRÉSENTATIONS</h3>
            <ul>
                <li>Organisation</li>
                <li>Fonctionnement</li>
                <li>Enjeux</li>
            </ul>
        </div>

        <div class="domaines-container">
            <h3>NOS DOMAINES D’EXCELLENCE</h3>

            <div class="domaines-block">
                @if (domaines_excellences == null)
                {
                    <p class="domaine-title">Chargement...</p>
                }
                else
                {
                    @foreach (var domaine_excellence in domaines_excellences)
                    {
                        <div class="domaine" @onclick="@(() => NavigationDomaine_Excellence(domaine_excellence.Id_Domaine_Excellence))">
                            @if (domaine_excellence?.Photos != null && domaine_excellence.Photos.Any())
                            {
                                <img src="@domaine_excellence.Photos.First().Url_Photo" class="domaine-img" />
                            }
                            <p class="domaine-title">@domaine_excellence.intitule_Domaine_Excellence</p>
                        </div>
                    }
                }
            </div>
        </div>

        <FormulaireContact />

    </div>
</div>

@code {
    private string SearchText = "";
    public int Id { get; set; }
    private IEnumerable<Domaine_Excellence> domaines_excellences = new List<Domaine_Excellence>();

    protected override async Task OnInitializedAsync()
    {
        domaines_excellences = await Domaine_ExcellenceService.GetAllAsync();

    }


    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            PerformSearch();
        }
    }

    private void PerformSearch()
    {
        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var encodedQuery = Uri.EscapeDataString(SearchText);
            Nav.NavigateTo($"/search/motclef/{encodedQuery}");
        }
    }

    private void RetourListe(int idEquipement, string nomChemin)
    {
        Nav.NavigateTo($"/{nomChemin}/{idEquipement}");
    }

    private void NavigationDomaine_Excellence(int id)
    {
        Nav.NavigateTo($"/DomaineExcellence/{id}");
    }
}