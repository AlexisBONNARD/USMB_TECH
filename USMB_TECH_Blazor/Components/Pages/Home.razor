@page "/"
@inject IMainService<Thematique,int> ThematiqueService
@inject IMainService<Plateforme,int> PlateformeService
@inject NavigationManager Nav
@inject IJSRuntime JS

<HeadContent>
    <link href="css/Home.css" rel="stylesheet" />
</HeadContent>

<PageTitle>Home</PageTitle>

<div class="hero-section">
    <p class="hero-text">
        <em id="text-home">Accédez à des équipements technologiques et expertises d’excellence</em>
    </p>

    <nav id="search-box-nav">
        <div class="search-box">
            <input @bind="SearchText"
                   @bind:event="oninput"
                   type="text"
                   placeholder="Recherche par mots clés"
                   @onkeydown="HandleKeyDown" />

            <button @onclick="PerformSearch">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </nav>
</div>


<div class="main-wrapper">
    <div class="main-content">

        <div class="presentations-section">
            <h3>PRÉSENTATIONS</h3>
            <ul>
                <li>Organisation</li>
                <li>Fonctionnement</li>
                <li>Enjeux</li>
            </ul>
        </div>

        <div class="domaines-container">
            <h3>NOS DOMAINES D’EXCELLENCE</h3>

            <div class="domaines-block">
                @if (thematiques == null)
                {
                    <p class="domaine-title">Chargement...</p>
                }
                else
                {
                    @foreach (var thematique in thematiques)
                    {
                        var firstExposer = thematique.Exposers.FirstOrDefault();
                        var plateforme = plateformes.FirstOrDefault(p => p.Id_Plateforme == firstExposer?.Id_Plateforme);

                        <div class="domaine" @onclick="@(() => FastShearche(thematique.Nom_Thematique, "thematique"))">
                            @if (plateforme?.Photos != null && plateforme.Photos.Any())
                            {
                                <img src="@plateforme.Photos.First().Url_Photo" class="domaine-img" />
                            }
                            <p class="domaine-title">@thematique.Nom_Thematique</p>
                        </div>
                    }
                }
            </div>
        </div>

        <FormulaireContact />

    </div>
</div>

@code {
    private string SearchText = "";
    public int Id { get; set; }
    private IEnumerable<Thematique> thematiques = new List<Thematique>();
    private List<Plateforme> plateformes = new List<Plateforme>();

    protected override async Task OnInitializedAsync()
    {
        thematiques = await ThematiqueService.GetAllAsync();
        await JS.InvokeVoidAsync("console.log", $"Thematique {thematiques}");

        foreach (var thematique in thematiques)
        {
            var firstExposer = thematique.Exposers.FirstOrDefault();

            if (firstExposer != null)
            {
                var plat = await PlateformeService.GetByIdAsync(firstExposer.Id_Plateforme);
                if (plat != null)
                    plateformes.Add(plat);
            }
        }
    }


    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            PerformSearch();
        }
    }

    private void PerformSearch()
    {
        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var encodedQuery = Uri.EscapeDataString(SearchText);
            Nav.NavigateTo($"/search/motclef/{encodedQuery}");
        }
    }

    private void RetourListe(int idEquipement, string nomChemin)
    {
        Nav.NavigateTo($"/{nomChemin}/{idEquipement}");
    }

    private void FastShearche(string nom, string nomChemin)
    {
        var encodedQuery = Uri.EscapeDataString(nom);
        Nav.NavigateTo($"/search/{nomChemin}/{encodedQuery}"); //motclef ou thematique ou motclef_thematique
    }
}