@page "/"
@inject IMainService<Thematique,int> ThematiqueService
@inject IMainService<Plateforme,int> PlateformeService
@inject NavigationManager Nav

<HeadContent>
    <link href="css/Home.css" rel="stylesheet" />
</HeadContent>

<PageTitle>Home</PageTitle>

<div class="hero-section">
    <p class="hero-text">
        <em id="text-home">Accédez à des équipements technologiques et expertises d’excellence</em>
    </p>

    <nav id="search-box-nav">
        <div class="search-box">
            <input @bind="SearchText"
                   @bind:event="oninput"
                   type="text"
                   placeholder="Recherche par mots clés"
                   @onkeydown="HandleKeyDown" />

            <button @onclick="PerformSearch">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </nav>
</div>


<div class="main-wrapper">
    <div class="main-content">

        <div class="presentations-section">
            <h3>PRÉSENTATIONS</h3>
            <ul>
                <li>Organisation</li>
                <li>Fonctionnement</li>
                <li>Enjeux</li>
            </ul>
        </div>

        <div class="domaines-container">
            <h3>NOS DOMAINES D’EXCELLENCE</h3>

            <div class="domaines-block">
                @foreach (var thematique in thematiques)
                {
                    <div class="domaine" @onclick="@(() => RetourListe(thematique.Id_Thematique, "thematique"))">
                        @* @if (thematique.Exposers.plateformeNavigation.Photos != null && thematique.Exposers.Photos.Any())
                            <img src="@photo.Url_Photo" class="domaine-img" />
                        } *@
                        <p class="domaine-title">@thematique.Nom_Thematique</p>
                    </div>
                }

                <div class="domaine">
                    <img src="/images/Interaction_environnement.jpg" class="domaine-img" />
                    <p class="domaine-title">Interaction<br />Homme-environnement</p>
                </div>

                <div class="domaine">
                    <img src="/images/Services_industrie.jpg" class="domaine-img" />
                    <p class="domaine-title">Services et<br />industrie du futur</p>
                </div>

                <div class="domaine">
                    <img src="/images/Patrimoine_culturel.jpg" class="domaine-img" />
                    <p class="domaine-title">Patrimoine culturel<br />et société en mutation</p>
                </div>
            </div>
        </div>

        <FormulaireContact />

    </div>
</div>

@code {
    private string SearchText = "";
    public int Id { get; set; }
    private IEnumerable<Thematique> thematiques = new List<Thematique>();
    // private List<Plateforme> plateformes = new List<Plateforme>();

    protected override async Task OnInitializedAsync()
    {
        thematiques = ThematiqueService.GetAllAsync().Result.ToList();

        // foreach (var thematique in thematiques)
        // {
        //     foreach (var plateforme in thematique.Exposers)
        //     {
        //         var plat = await PlateformeService.GetByIdAsync(plateforme.Id_Plateforme);
        //         this.plateformes.Add(plat);
        //     }
        //     var plat = await PlateformeService.GetByIdAsync(thematique.Id_Plateforme);
        //     this.plateformes.Add(plat);
        // }
    }


    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            PerformSearch();
        }
    }

    private void PerformSearch()
    {
        if (!string.IsNullOrWhiteSpace(SearchText))
        {
            var encodedQuery = Uri.EscapeDataString(SearchText);
            Nav.NavigateTo($"/search/motclef/{encodedQuery}");
        }
    }

    private void RetourListe(int idEquipement, string nomChemin)
    {
        Nav.NavigateTo($"/{nomChemin}/{idEquipement}");
    }
}