@page "/"


<div class="hero-section">
    <p class="hero-text">
        <em id="text-home">Accédez à des équipements technologiques et expertises d’excellence</em>
    </p>

    <nav id="search-box-nav">
        <div class="search-box">
            <input type="text" placeholder="Recherche par mots clés" />
            <button><i class="bi bi-search"></i></button>
        </div>
    </nav>
</div>


<div class="main-wrapper">
    <div class="main-content">

        <div class="presentations-section">
            <h3>PRÉSENTATIONS</h3>
            <ul>
                <li>Organisation</li>
                <li>Fonctionnement</li>
                <li>Enjeux</li>
            </ul>
        </div>

        <div class="domaines-container">
            <h3>NOS DOMAINES D’EXCELLENCE</h3>

            <div class="domaines-block">
                <div class="domaine">
                    <img src="/images/domaine1.jpg" class="domaine-img" />
                    <p class="domaine-title">Interaction<br />Homme-environnement</p>
                </div>

                <div class="domaine">
                    <img src="/images/domaine2.jpg" class="domaine-img" />
                    <p class="domaine-title">Services et<br />industrie du futur</p>
                </div>

                <div class="domaine">
                    <img src="/images/domaine3.jpg" class="domaine-img" />
                    <p class="domaine-title">Patrimoine culturel<br />et société en mutation</p>
                </div>
            </div>
        </div>

        <div class="contact-section">
            <h3>FORMULAIRE DE CONTACT</h3>

            <div class="form-container">
                <div class="row">
                    <input class="input half" placeholder="Nom*" />
                    <input class="input half" placeholder="Prénom" />
                </div>

                <input class="input" placeholder="Email*" />

                <input class="input" placeholder="Type d’entité (entreprise, collectivité, association…)" />

                <textarea class="input textarea" placeholder="Votre besoin"></textarea>

                <button class="submit-btn">ENVOYER</button>
            </div>
        </div>

    </div>
</div>
